        <PathAndCredentials wcm:action="add" wcm:keyValue="10"><Path>E:\NetKVM\w11\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="11"><Path>E:\vioserial\w11\amd64</Path></PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="12"><Path>E:\Balloon\w11\amd64</Path></PathAndCredentials>
