+/* Number of single-sampled draws that stand in for one forced-sample draw, or
+ * 0 when the draw is not the XOR coverage accumulation of target-independent
+ * rasterization (Direct2D: SV_Coverage XORed into an R16_UINT target).
+ *
+ * The interlock path below rasterizes once at the forced sample count and
+ * XORs under a fragment shader pixel interlock.  Seen with an NVIDIA host
+ * (Venus): two fragments of one pixel with disjoint coverage (the triangles
+ * on either side of a shared edge) lose one of their XORs, as if the lock
+ * did not hold between them: thin gaps along the inner edges of Direct2D's
+ * triangle fans, in different places on every run.  One draw per sample needs
+ * no lock: each draw is single-sampled with the viewport moved so that the
+ * pixel centre falls on that sample's position, and the blender's logic op
+ * XORs that sample's bit in primitive order.
+ */
+static uint32_t
+yttrium_pipeline_forced_sample_pass_count(
+   struct yttrium_context *yctx,
+   const struct yttrium_resource *dst,
+   const struct yttrium_venus_draw_state *draw_state)
+{
+   struct yttrium_shader_state *fs =
+      yctx ? yctx->shaders[MESA_SHADER_FRAGMENT] : NULL;
+   const struct pipe_surface *cbuf =
+      yctx && yctx->fb.nr_cbufs == 1 ? &yctx->fb.cbufs[0] : NULL;
+
+   if (!yttrium_pipeline_forced_sample_passes_enabled() ||
+       !dst || !draw_state || !fs || !fs->nir || !cbuf || !cbuf->texture ||
+       yttrium_resource(cbuf->texture) != dst || yctx->fb.zsbuf.texture ||
+       draw_state->rt_count != 1 || draw_state->viewport_count > 1 ||
+       !yttrium_pipeline_forced_sample_offset(
+          draw_state->forced_sample_count, 0) ||
+       !draw_state->logic_op_enable ||
+       draw_state->logic_op != VK_LOGIC_OP_XOR ||
+       draw_state->rt_blend_enable[0] ||
+       !(draw_state->rt_color_write_mask[0] & VK_COLOR_COMPONENT_R_BIT) ||
+       draw_state->alpha_test_enable ||
+       draw_state->alpha_to_coverage_enable ||
+       cbuf->format != PIPE_FORMAT_R16_UINT ||
+       dst->base.target != PIPE_TEXTURE_2D ||
+       MAX2(dst->base.nr_samples, 1) != 1 ||
+       dst->venus.vk_format != VK_FORMAT_R16_UINT ||
+       !yttrium_shader_state_uses_sample_mask_in(fs) ||
+       yttrium_pipeline_fs_uses_sample_shading(fs))
+      return 0;
+
+   return draw_state->forced_sample_count;
+}
