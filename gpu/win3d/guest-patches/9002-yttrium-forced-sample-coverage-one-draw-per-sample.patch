+/* D3D11's standard sample positions, in sixteenths of a pixel from the pixel
+ * centre (D3D11_STANDARD_MULTISAMPLE_PATTERN).
+ */
+static const int8_t yttrium_forced_sample_offsets_2[2][2] = {
+   { 4, 4 }, { -4, -4 },
+};
+static const int8_t yttrium_forced_sample_offsets_4[4][2] = {
