+static const int8_t *
+yttrium_pipeline_forced_sample_offset(uint32_t sample_count, uint32_t sample)
+{
+   switch (sample_count) {
+   case 2:
+      return yttrium_forced_sample_offsets_2[sample];
+   case 4:
+      return yttrium_forced_sample_offsets_4[sample];
+   case 8:
+      return yttrium_forced_sample_offsets_8[sample];
+   case 16:
+      return yttrium_forced_sample_offsets_16[sample];
+   default:
+      return NULL;
+   }
+}
+
+static bool
+yttrium_pipeline_forced_sample_passes_enabled(void)
+{
+   static int enabled = -1;
+
+   if (enabled < 0)
+      enabled = yttrium_gdi_debug_get_bool_option(
+         "D3D10UMD_YTTRIUM_FORCED_SAMPLE_PASSES", true) ? 1 : 0;
+
+   return enabled != 0;
+}
