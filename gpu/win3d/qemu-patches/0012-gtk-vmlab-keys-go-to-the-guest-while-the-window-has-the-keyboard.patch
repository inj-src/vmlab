+/* the compositor's globals, asked for once */
+static void vmlab_wl_globals(GtkWidget *window, struct wl_display *display)
+{
+    struct wl_display *wrapper;
+    struct wl_event_queue *queue;
+    struct wl_registry *registry;
+
+    if (wl.looked) {
+        return;
+    }
+    wl.looked = true;
+    /*
+     * The globals are found on a queue of their own, so that GDK's events stay where GDK
+     * reads them, and then moved to the display's queue, which GDK's main loop reads:
+     * what is made from them answers there.
+     */
+    queue = wl_display_create_queue(display);
+    wrapper = wl_proxy_create_wrapper(display);
+    wl_proxy_set_queue((struct wl_proxy *)wrapper, queue);
+    registry = wl_display_get_registry(wrapper);
+    wl_proxy_wrapper_destroy(wrapper);
+    wl_registry_add_listener(registry, &registry_listener, NULL);
+    wl_display_roundtrip_queue(display, queue);
+    wl_display_roundtrip_queue(display, queue);
+    if (wl.compositor) {
+        wl_proxy_set_queue((struct wl_proxy *)wl.compositor, NULL);
+    }
+    if (wl.subcompositor) {
+        wl_proxy_set_queue((struct wl_proxy *)wl.subcompositor, NULL);
+    }
+    if (wl.shm) {
+        wl_proxy_set_queue((struct wl_proxy *)wl.shm, NULL);
+    }
+    if (wl.viewporter) {
+        wl_proxy_set_queue((struct wl_proxy *)wl.viewporter, NULL);
+    }
+    if (wl.scales) {
+        wl_proxy_set_queue((struct wl_proxy *)wl.scales, NULL);
+    }
+    if (wl.inhibit_manager) {
+        wl_proxy_set_queue((struct wl_proxy *)wl.inhibit_manager, NULL);
+    }
+    wl_registry_destroy(registry);
+    wl_event_queue_destroy(queue);
+    g_signal_connect(window, "unmap", G_CALLBACK(window_unmapped), NULL);
+}
+
+static void inhibitor_active(void *data, struct zwp_keyboard_shortcuts_inhibitor_v1 *inhibitor)
+{
+    wl.inhibitor_off = false;
+}
+
+static void inhibitor_inactive(void *data, struct zwp_keyboard_shortcuts_inhibitor_v1 *inhibitor)
+{
+    wl.inhibitor_off = true;
+}
+
+static const struct zwp_keyboard_shortcuts_inhibitor_v1_listener inhibitor_listener = {
+    .active = inhibitor_active,
+    .inactive = inhibitor_inactive,
+};
+
+/*
+ * Every key is the guest's while the window has the keyboard, the desktop's own shortcuts
+ * too (the Windows key, Alt+Tab): the compositor's shortcuts inhibitor for the window. It is
+ * asked for once, when the window first has the keyboard, and kept while the window is mapped;
+ * the compositor applies it only while the window has the keyboard. (Not GDK's keyboard grab,
+ * which asks and lets go at each change of focus: GNOME asks the person once whether to allow
+ * it, its question takes the keyboard for a moment, and letting go then withdraws the
+ * question.) When the compositor has taken it back (GNOME's Super+Escape gives the desktop its
+ * shortcuts again), it is asked for anew the next time the window gains the keyboard; GNOME
+ * then answers as the person did before, without asking. The pointer is never held. Called
+ * when the window gains the keyboard.
+ */
+void vmlab_wl_keys_to_guest(VirtualConsole *vc)
+{
+    GtkWidget *window = gtk_widget_get_toplevel(vc->gfx.drawing_area);
+    GdkWindow *gdk_window = gtk_widget_get_window(window);
+    GdkDisplay *gdk_display = gtk_widget_get_display(window);
+    struct wl_display *display;
+    struct wl_surface *surface;
+    struct wl_seat *seat;
+
+    if (wl.inhibitor && wl.inhibitor_off) {
+        g_clear_pointer(&wl.inhibitor, zwp_keyboard_shortcuts_inhibitor_v1_destroy);
+    }
+    if (wl.inhibitor || !g_getenv("VMLAB_WINDOW") || !gdk_window ||
+        !gtk_widget_get_mapped(window) || !GDK_IS_WAYLAND_DISPLAY(gdk_display)) {
+        return;
+    }
+    display = gdk_wayland_display_get_wl_display(gdk_display);
+    surface = gdk_wayland_window_get_wl_surface(gdk_window);
+    seat = gdk_wayland_seat_get_wl_seat(gdk_display_get_default_seat(gdk_display));
+    if (!display || !surface || !seat) {
+        return;
+    }
+    vmlab_wl_globals(window, display);
+    if (!wl.inhibit_manager) {
+        return;
+    }
+    wl.inhibitor_off = false;
+    wl.inhibitor = zwp_keyboard_shortcuts_inhibit_manager_v1_inhibit_shortcuts(
+        wl.inhibit_manager, surface, seat);
+    zwp_keyboard_shortcuts_inhibitor_v1_add_listener(wl.inhibitor, &inhibitor_listener, NULL);
+}
