 /* ------------------------------------------------------------------ */
+/* vmlab: files to the guest                                          */
+
+static void vdagent_xfer_free(VDAgentXfer *x)
+{
+    close(x->fd);
+    g_free(x->name);
+    g_free(x);
+}
+
+static void vdagent_xfer_drop_all(VDAgentChardev *vd)
+{
+    g_list_free_full(g_steal_pointer(&vd->xfers), (GDestroyNotify)vdagent_xfer_free);
+}
+
+/* Tells the guest of the first file, once: it answers with a status (can send data). */
+static void vdagent_xfer_start(VDAgentChardev *vd)
+{
+    VDAgentXfer *x = vd->xfers ? vd->xfers->data : NULL;
+    g_autoptr(GKeyFile) keys = NULL;
+    g_autofree char *meta = NULL;
+    g_autofree VDAgentMessage *msg = NULL;
+    VDAgentFileXferStartMessage *start;
+    gsize len;
+
+    if (!x || x->started) {
+        return;
+    }
+    keys = g_key_file_new();
+    g_key_file_set_string(keys, "vdagent-file-xfer", "name", x->name);
+    g_key_file_set_uint64(keys, "vdagent-file-xfer", "size", x->size);
+    meta = g_key_file_to_data(keys, &len, NULL);
+    len += 1; /* with its NUL */
+    msg = g_malloc0(sizeof(VDAgentMessage) + sizeof(*start) + len);
+    start = (void *)msg->data;
+    start->id = x->id;
+    memcpy(start->data, meta, len);
+    msg->type = VD_AGENT_FILE_XFER_START;
+    msg->size = sizeof(*start) + len;
+    x->started = true;
+    vdagent_send_msg(vd, msg);
+}
+
+static void vdagent_xfer_finish(VDAgentChardev *vd, VDAgentXfer *x)
+{
+    vd->xfers = g_list_remove(vd->xfers, x);
+    vdagent_xfer_free(x);
+    vdagent_xfer_start(vd);
+}
+
+/* Queues the next pieces of the first file while little waits for the guest to read. */
+static void vdagent_xfer_pump(VDAgentChardev *vd)
+{
+    VDAgentXfer *x = vd->xfers ? vd->xfers->data : NULL;
+
+    while (x && x->can_send && vd->outbuf->len < VDAGENT_XFER_QUEUE &&
+           (x->sent < x->size || !x->empty_sent)) {
+        uint64_t want = MIN(x->size - x->sent, VDAGENT_XFER_CHUNK);
+        g_autofree VDAgentMessage *msg =
+            g_malloc0(sizeof(VDAgentMessage) + sizeof(VDAgentFileXferDataMessage) + want);
+        VDAgentFileXferDataMessage *data = (void *)msg->data;
+        ssize_t got = want ? read(x->fd, data->data, want) : 0;
+
+        if (got < 0 || (want && got == 0)) {
+            /* it cannot be read to its end: the guest drops what it has */
+            g_autofree VDAgentMessage *end =
+                g_malloc0(sizeof(VDAgentMessage) + sizeof(VDAgentFileXferStatusMessage));
+            VDAgentFileXferStatusMessage *status = (void *)end->data;
+
+            warn_report("vmlab: file drop: reading %s failed, cancelled", x->name);
+            status->id = x->id;
+            status->result = VD_AGENT_FILE_XFER_STATUS_CANCELLED;
+            end->type = VD_AGENT_FILE_XFER_STATUS;
+            end->size = sizeof(*status);
+            vdagent_send_msg(vd, end);
+            vdagent_xfer_finish(vd, x);
+            return;
+        }
+        data->id = x->id;
+        data->size = got;
+        msg->type = VD_AGENT_FILE_XFER_DATA;
+        msg->size = sizeof(*data) + got;
+        x->sent += got;
+        x->empty_sent = true; /* an empty file is one piece of no bytes */
+        vdagent_send_msg(vd, msg);
+    }
+}
+
+static void vdagent_chr_recv_xfer_status(VDAgentChardev *vd, VDAgentMessage *msg)
+{
+    VDAgentFileXferStatusMessage *status = (void *)msg->data;
+    VDAgentXfer *x = vd->xfers ? vd->xfers->data : NULL;
+
+    if (msg->size < sizeof(*status) || !x || !x->started || x->id != status->id) {
+        return;
+    }
+    switch (status->result) {
+    case VD_AGENT_FILE_XFER_STATUS_CAN_SEND_DATA:
+        x->can_send = true;
+        vdagent_xfer_pump(vd);
+        break;
+    case VD_AGENT_FILE_XFER_STATUS_SUCCESS:
+        info_report("vmlab: file drop: %s is on the guest's desktop", x->name);
+        vdagent_xfer_finish(vd, x);
+        break;
+    default:
+        warn_report("vmlab: file drop: the guest did not take %s (status %u)",
+                    x->name, status->result);
+        vdagent_xfer_finish(vd, x);
+        break;
+    }
+}
+
+bool qemu_vdagent_send_file(const char *path)
+{
+    VDAgentChardev *vd = vdagent_xfer_chardev;
+    VDAgentXfer *x;
+    struct stat st;
+    int fd;
+
+    if (!vd || !vd->connected || !vd->caps) {
+        warn_report("vmlab: file drop: the guest's agent is not connected (%s)", path);
+        return false;
+    }
+    fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0 || fstat(fd, &st) < 0 || !S_ISREG(st.st_mode)) {
+        warn_report("vmlab: file drop: %s is not a file that can be read", path);
+        if (fd >= 0) {
+            close(fd);
+        }
+        return false;
+    }
+    x = g_new0(VDAgentXfer, 1);
+    x->id = ++vd->xfer_id;
+    x->name = g_path_get_basename(path);
+    x->fd = fd;
+    x->size = st.st_size;
+    vd->xfers = g_list_append(vd->xfers, x);
+    vdagent_xfer_start(vd);
+    return true;
+}
