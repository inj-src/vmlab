+/* vmlab: the arrow is drawn into the picture or not, and where (vmlab_arrow above) */
+static gboolean vmlab_arrow_recheck(gpointer opaque);
+
+static void vmlab_arrow_update(VirtualConsole *vc, bool changed)
+{
+    GtkDisplayState *s = vc->s;
+    QEMUCursor *c = vmlab_cursor;
+    int64_t still = g_get_monotonic_time() - vmlab_arrow.host_moved;
+    bool drawn = false;
+
+    if (qemu_input_is_absolute(vc->gfx.dcl.con) && s->guest_cursor && c &&
+        vmlab_arrow.known && !s->guest_cursor_hidden) {
+        if (!vmlab_arrow.inside) {
+            drawn = true;
+        } else if (still < VMLAB_ARROW_HOST_US) {
+            /* the host's pointer drives it, and what the guest says lags behind the pointer */
+            if (!vmlab_arrow.recheck) {
+                vmlab_arrow.recheck = g_timeout_add((VMLAB_ARROW_HOST_US - still) / 1000 + 10,
+                                                    vmlab_arrow_recheck, vc);
+            }
+        } else {
+            /* the driver says where the arrow's top-left is, the host's pointer is its tip */
+            drawn = abs(vmlab_arrow.x + c->hot_x - s->last_x) > 2 ||
+                    abs(vmlab_arrow.y + c->hot_y - s->last_y) > 2;
+        }
+    }
+    if (drawn != vmlab_arrow.drawn) {
+        vmlab_arrow.drawn = drawn;
+        gd_update_cursor(vc);
+    } else if (!drawn || !changed) {
+        return;
+    }
+    if (!vmlab_wl_arrow(vc, drawn ? c : NULL, vmlab_arrow.premultiplied,
+                        vmlab_arrow.x, vmlab_arrow.y)) {
+        gtk_widget_queue_draw(vc->gfx.drawing_area);
+    }
+}
+
+static gboolean vmlab_arrow_recheck(gpointer opaque)
+{
+    vmlab_arrow.recheck = 0;
+    vmlab_arrow_update(opaque, false);
+    return G_SOURCE_REMOVE;
+}
+
+/* vmlab: the host's pointer moved, over the picture or off it */
+static void vmlab_arrow_host(VirtualConsole *vc, bool inside)
+{
+    bool was = vmlab_arrow.inside;
+
+    vmlab_arrow.inside = inside;
+    if (inside) {
+        vmlab_arrow.host_moved = g_get_monotonic_time();
+    }
+    if (inside != was || vmlab_arrow.drawn) {
+        vmlab_arrow_update(vc, false);
+    }
+}
+
+/* vmlab: the arrow onto GTK's drawing of the picture, at (x, y) in the picture's pixels */
+static void vmlab_arrow_paint(cairo_t *cr, double x, double y)
+{
+    QEMUCursor *c = vmlab_cursor;
+    int i, n = c->width * c->height;
+    uint32_t *px = g_new(uint32_t, n);
+    cairo_surface_t *image;
+
+    for (i = 0; i < n; i++) {
+        uint32_t p = c->data[i], a = p >> 24;
+
+        px[i] = vmlab_arrow.premultiplied ? p :
+            a << 24 | (((p >> 16) & 0xff) * a / 255) << 16 |
+            (((p >> 8) & 0xff) * a / 255) << 8 | (p & 0xff) * a / 255;
+    }
+    image = cairo_image_surface_create_for_data((unsigned char *)px, CAIRO_FORMAT_ARGB32,
+                                                c->width, c->height, c->width * 4);
+    cairo_set_source_surface(cr, image, x, y);
+    cairo_paint(cr);
+    cairo_surface_destroy(image);
+    g_free(px);
+}
