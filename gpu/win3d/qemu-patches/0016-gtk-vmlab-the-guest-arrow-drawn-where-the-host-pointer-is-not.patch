 static void vmlab_wl_present(VirtualConsole *vc, int x, int y, int w, int h);
 
+/* adds that rectangle to what is to be filled again in that buffer */
+static void grow(VmlabBuffer *b, int x1, int y1, int x2, int y2)
+{
+    if (x2 <= x1 || y2 <= y1) {
+        return;
+    }
+    if (b->x2 <= b->x1 || b->y2 <= b->y1) {
+        b->x1 = x1;
+        b->y1 = y1;
+        b->x2 = x2;
+        b->y2 = y2;
+    } else {
+        b->x1 = MIN(b->x1, x1);
+        b->y1 = MIN(b->y1, y1);
+        b->x2 = MAX(b->x2, x2);
+        b->y2 = MAX(b->y2, y2);
+    }
+}
+
+/* where the guest's arrow goes in the picture; false: nowhere */
+static bool arrow_rect(int *x1, int *y1, int *x2, int *y2)
+{
+    if (!wl.arrow) {
+        return false;
+    }
+    *x1 = MAX(wl.arrow_x, 0);
+    *y1 = MAX(wl.arrow_y, 0);
+    *x2 = MIN(wl.arrow_x + wl.arrow->width, wl.fbw);
+    *y2 = MIN(wl.arrow_y + wl.arrow->height, wl.fbh);
+    return *x2 > *x1 && *y2 > *y1;
+}
+
+/* draws the guest's arrow over that part of the buffer, which holds the picture there */
+static void arrow_blend(VmlabBuffer *b, int x1, int y1, int x2, int y2)
+{
+    QEMUCursor *c = wl.arrow;
+    int row, col, sh;
+
+    for (row = y1; row < y2; row++) {
+        uint32_t *d = (uint32_t *)b->data + (size_t)row * b->w;
+        const uint32_t *s = c->data + (size_t)(row - wl.arrow_y) * c->width - wl.arrow_x;
+
+        for (col = x1; col < x2; col++) {
+            uint32_t p = s[col], a = p >> 24, q = d[col], o = 0;
+
+            if (!a) {
+                continue;
+            }
+            for (sh = 0; sh < 24; sh += 8) {
+                uint32_t sc = (p >> sh) & 0xff, dc = (q >> sh) & 0xff;
+
+                if (!wl.arrow_premultiplied) {
+                    sc = sc * a / 255;
+                }
+                o |= MIN(255, sc + dc * (255 - a) / 255) << sh;
+            }
+            d[col] = o;
+        }
+    }
+}
+
