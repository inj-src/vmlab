+/*
+ * vmlab: the guest's arrow where the host's pointer is not driving it. While the host's pointer
+ * moves the guest's, it wears the guest's arrow (above). When something in the guest moves the
+ * arrow instead (Remote Desktop, an agent's input), or the host's pointer is off the picture,
+ * the arrow is drawn into the picture where the guest has it, as a monitor shows it, and the
+ * host's pointer over the picture is blank.
+ */
+#define VMLAB_ARROW_HOST_US 250000  /* the host's pointer drives the arrow this long after a move */
+static struct {
+    bool known;                 /* the guest has said where its arrow is */
+    int x, y;                   /* the arrow's top-left in the picture, as the guest says */
+    bool inside;                /* the host's pointer is over the picture */
+    int64_t host_moved;         /* when it last moved the guest's (g_get_monotonic_time) */
+    bool drawn;                 /* the arrow is drawn into the picture */
+    bool premultiplied;         /* its colour is multiplied by its alpha */
+    guint recheck;              /* for when the host's pointer has been still long enough */
+} vmlab_arrow;
 
