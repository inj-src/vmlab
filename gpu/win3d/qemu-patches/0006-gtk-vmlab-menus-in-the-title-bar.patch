gtk: vmlab: the menus in the title bar

The VMLAB_WINDOW window gets a title bar of its own (a GtkHeaderBar of the desktop's usual
height) with QEMU's menu bar, Machine and View, at its right, in place of a row of its own
under the title bar: the menus stay in reach and take no rows from the guest's picture (the
user's request). 0005's hiding of the menu bar goes. Full screen in that window keeps the
picture's shape (QEMU stretches it to the screen otherwise): a 1920x1042 guest shows unscaled
on a 1920x1080 screen, with 19 rows of black above and below.

--- a/include/ui/gtk.h
+++ b/include/ui/gtk.h
@@ -141,6 +141,7 @@
     gboolean full_screen;
 
     GdkCursor *null_cursor;
+    GtkWidget *vmlab_header;      /* vmlab: the title bar that holds the menus */
     GdkCursor *guest_cursor;      /* vmlab: the guest's pointer shape, for an absolute pointer */
     bool guest_cursor_hidden;
     Notifier mouse_mode_notifier;
--- a/system/vl.c
+++ b/system/vl.c
@@ -1398,9 +1398,6 @@
         dpy_window.gl = DISPLAY_GL_MODE_OFF;
         dpy_window.u.gtk.has_zoom_to_fit = true;
         dpy_window.u.gtk.zoom_to_fit = true;
-        /* no menu bar (Ctrl+Alt+M shows it): its rows are the guest's; VMLAB_WINDOW_MENUBAR keeps it */
-        dpy_window.u.gtk.has_show_menubar = true;
-        dpy_window.u.gtk.show_menubar = g_getenv("VMLAB_WINDOW_MENUBAR") != NULL;
         qemu_display_early_init(&dpy_window);
     }
 }
