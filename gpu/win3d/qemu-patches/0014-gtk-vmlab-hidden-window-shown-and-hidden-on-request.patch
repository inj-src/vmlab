-static GtkWidget *gd_vmlab_full_screen_button(GtkDisplayState *s)
+/*
+ * vmlab: the window can be off the screen while the VM runs, and come back. VMLAB_WINDOW_HIDDEN=1
+ * makes it at the start without showing it (the VM is started for an agent, with no one
+ * watching); VMLAB_WINDOW_CONTROL names a pipe (a FIFO the launcher made) that takes "show" and
+ * "hide", a line each, from `vm view` and the launcher; VMLAB_WINDOW_STATE_FILE is kept at
+ * "shown" or "hidden". A hidden window is no window on the desktop: not in the dock, not in
+ * Alt+Tab, and it takes no keys. The clipboard is not shared while it is hidden
+ * (gtk-clipboard.c). The title bar's hide button (left of full screen) is there only with the
+ * pipe, the one way to show the window again.
+ */
+static void gd_vmlab_window_state(GtkDisplayState *s)
+{
+    const char *path = g_getenv("VMLAB_WINDOW_STATE_FILE");
+
+    if (path) {
+        g_file_set_contents(path, gtk_widget_get_visible(s->window) ? "shown\n" : "hidden\n",
+                            -1, NULL);
+    }
+}
+
+static void gd_vmlab_show(GtkDisplayState *s)
+{
+    if (!gtk_widget_get_visible(s->window) && g_getenv("VMLAB_WINDOW_MAXIMIZE")) {
+        gtk_window_maximize(GTK_WINDOW(s->window));
+    }
+    gtk_window_present(GTK_WINDOW(s->window));
+    gd_vmlab_window_state(s);
+}
+
+static void gd_vmlab_hide(GtkDisplayState *s)
+{
+    gtk_widget_hide(s->window);
+    gd_vmlab_window_state(s);
+}
+
+static gboolean gd_vmlab_control(gint fd, GIOCondition condition, gpointer opaque)
+{
+    GtkDisplayState *s = opaque;
+    char buf[256];
+    ssize_t n;
+
+    while ((n = read(fd, buf, sizeof(buf) - 1)) > 0) {
+        g_auto(GStrv) lines = NULL;
+        char **line;
+
+        buf[n] = 0;
+        lines = g_strsplit(buf, "\n", -1);
+        for (line = lines; *line; line++) {
+            g_strstrip(*line);
+            if (!strcmp(*line, "show")) {
+                gd_vmlab_show(s);
+            } else if (!strcmp(*line, "hide")) {
+                gd_vmlab_hide(s);
+            } else if (**line) {
+                warn_report("vmlab: the window's control pipe got \"%s\" (show or hide)", *line);
+            }
+        }
+    }
+    return G_SOURCE_CONTINUE;
+}
+
+/* the pipe stays open for reading and writing, so it never reads as ended between writers */
+static bool gd_vmlab_control_init(GtkDisplayState *s)
 {
-    GtkWidget *button = gtk_button_new_from_icon_name("view-fullscreen-symbolic",
-                                                      GTK_ICON_SIZE_MENU);
+    const char *path = g_getenv("VMLAB_WINDOW_CONTROL");
+    int fd;
+
+    if (!path) {
+        return false;
+    }
+    fd = open(path, O_RDWR | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        warn_report("vmlab: the window's control pipe %s: %s", path, strerror(errno));
+        return false;
+    }
+    g_unix_fd_add(fd, G_IO_IN, gd_vmlab_control, s);
+    return true;
+}
+
+static void gd_vmlab_hide_clicked(GtkButton *button, void *opaque)
+{
+    gd_vmlab_hide(opaque);
+}
