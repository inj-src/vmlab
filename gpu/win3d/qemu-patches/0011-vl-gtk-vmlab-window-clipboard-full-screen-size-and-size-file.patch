+/*
+ * Takes the picture off the window until GTK has drawn the window again (vmlab_wl_cover). A
+ * picture that covers the whole window, as in full screen at the screen's size, leaves the
+ * compositor nothing of the window itself to draw, so the window gets no frame callbacks; GTK
+ * waits for one before it draws, and would never draw the window at the size it is given when
+ * it leaves full screen. With the picture off, the window is drawn and the callback comes.
+ */
+static void cover(VirtualConsole *vc)
+{
+    wl.uncovered = false;
+    if (wl.cover_timer) {
+        g_source_remove(wl.cover_timer);
+        wl.cover_timer = 0;
+    }
+    vmlab_wl_switch(vc);
+}
+
+static gboolean cover_cb(gpointer opaque)
+{
+    wl.cover_timer = 0;
+    cover(wl.vc);
+    return G_SOURCE_REMOVE;
+}
+
+void vmlab_wl_uncover(VirtualConsole *vc)
+{
+    if (!vmlab_wl_active(vc) || wl.uncovered) {
+        return;
+    }
+    wl.uncovered = true;
+    wl_surface_attach(wl.surface, NULL, 0, 0);
+    wl_surface_commit(wl.surface);
+    /* (should the window's size stay as it is) */
+    wl.cover_timer = g_timeout_add(500, cover_cb, NULL);
+}
+
+/*
+ * GTK draws the window. Once that is at the window's new size the picture goes back on it. (A
+ * draw at the old size can come first, the one the frame callback set off: the picture put back
+ * then would cover the window again before it has its new size.)
+ */
+void vmlab_wl_cover(VirtualConsole *vc)
+{
+    GtkWidget *area;
+
+    if (!wl.uncovered || !vmlab_wl_active(vc)) {
+        return;
+    }
+    area = vc->gfx.drawing_area;
+    if (gtk_widget_get_allocated_width(area) != wl.aw ||
+        gtk_widget_get_allocated_height(area) != wl.ah) {
+        cover(vc);
+    }
+}
+
 /* The guest changed that part of its picture. False: GTK is to draw it. */
 bool vmlab_wl_update(VirtualConsole *vc, int x, int y, int w, int h)
 {
     if (!vmlab_wl_active(vc)) {
         return false;
     }
