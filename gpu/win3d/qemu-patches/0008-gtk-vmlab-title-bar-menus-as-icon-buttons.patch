gtk: vmlab: the title bar's menus as icon buttons

The VMLAB_WINDOW window's title bar holds two icon buttons at its right, left of the window's
own buttons, in place of the menu bar's words (0006): the machine's menu (a power sign) and
the view's (a screen). They open QEMU's own menus; the menus' keys (Ctrl+Alt+F, Ctrl+Alt+G)
work as before. The buttons take no keyboard focus, so keys stay the guest's. (The user's
request.)

--- a/ui/gtk.c
+++ b/ui/gtk.c
@@ -3036,6 +3036,39 @@
 static GtkDisplayState *gtk_display_state;
 static gboolean gtkinit;
 
+/*
+ * vmlab: a title bar button with that icon which opens the menu of that menu bar item. It
+ * takes no keyboard focus: the keys stay the guest's.
+ */
+static GtkWidget *gd_vmlab_menu_button(GtkWidget *item, const char *icon, const char *name)
+{
+    GtkWidget *button = gtk_menu_button_new();
+    GtkWidget *menu = gtk_menu_item_get_submenu(GTK_MENU_ITEM(item));
+    GtkCssProvider *css = gtk_css_provider_new();
+
+    g_object_ref(menu);
+    gtk_menu_item_set_submenu(GTK_MENU_ITEM(item), NULL);
+    gtk_menu_button_set_popup(GTK_MENU_BUTTON(button), menu);
+    g_object_unref(menu);
+    gtk_widget_set_halign(menu, GTK_ALIGN_END);
+    gtk_button_set_image(GTK_BUTTON(button),
+                         gtk_image_new_from_icon_name(icon, GTK_ICON_SIZE_MENU));
+    gtk_button_set_relief(GTK_BUTTON(button), GTK_RELIEF_NONE);
+    gtk_widget_set_tooltip_text(button, name);
+    gtk_widget_set_can_focus(button, FALSE);
+    gtk_widget_set_focus_on_click(button, FALSE);
+    gtk_widget_set_valign(button, GTK_ALIGN_CENTER);
+    /* the size of the window's own buttons beside it */
+    gtk_css_provider_load_from_data(css,
+        "button { min-width: 24px; min-height: 24px; padding: 2px; margin: 0 1px;"
+        " border-radius: 9999px; }", -1, NULL);
+    gtk_style_context_add_provider(gtk_widget_get_style_context(button),
+                                   GTK_STYLE_PROVIDER(css),
+                                   GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
+    g_object_unref(css);
+    return button;
+}
+
 static void gtk_display_init(DisplayState *ds, DisplayOptions *opts)
 {
     VirtualConsole *vc;
@@ -3109,26 +3142,23 @@
 
