+static void
+draw_window_button(struct libdecor_frame_cairo *frame_cairo,
+		   cairo_t *cr,
+		   struct border_component *button,
+		   const unsigned char *const *icon,
+		   bool usable,
+		   bool window_active,
+		   const struct palette *palette,
+		   int scale)
+{
+	const double x = button_centre_x(frame_cairo, button->type);
+	double disc = window_active ? 0.10 : 0;
+
+	if (usable && frame_cairo->active == button) {
+		/* under the pointer; held down */
+		disc = 0.15;
+		if (frame_cairo->grab == button && frame_cairo->focus == button)
+			disc = 0.25;
+	}
+
+	if (disc > 0) {
+		cairo_arc(cr, x, BUTTON_CENTRE_Y, WINDOW_BUTTON_RADIUS, 0, 2 * M_PI);
+		set_grey(cr, palette->fg, disc);
+		cairo_fill(cr);
+	}
+
+	set_grey(cr, palette->fg, usable ? 1 : 0.5);
+	draw_icon(cr, icon, scale,
+		  x - VMLAB_ICON_UNITS / 2, BUTTON_CENTRE_Y - VMLAB_ICON_UNITS / 2);
+}
+
+static void
+draw_round_button(struct libdecor_frame_cairo *frame_cairo,
+		  cairo_t *cr,
+		  struct border_component *button,
+		  const unsigned char *const *icon,
+		  const struct palette *palette,
+		  int scale)
+{
+	const double x = button_centre_x(frame_cairo, button->type);
+	const double *look = NULL;
+
+	if (frame_cairo->active == button)
+		look = frame_cairo->grab == button && frame_cairo->focus == button ?
+			ROUND_BUTTON_PRESSED : ROUND_BUTTON_HOVER;
+
+	if (look) {
+		cairo_arc(cr, x, BUTTON_CENTRE_Y, ROUND_BUTTON_RADIUS, 0, 2 * M_PI);
+		set_grey(cr, look[0], 1);
+		cairo_fill(cr);
+		cairo_arc(cr, x, BUTTON_CENTRE_Y, ROUND_BUTTON_RADIUS - 0.5, 0, 2 * M_PI);
+		set_grey(cr, look[1], 1);
+		cairo_set_line_width(cr, 1);
+		cairo_stroke(cr);
+	}
+
+	set_grey(cr, palette->fg, 1);
+	draw_icon(cr, icon, scale,
+		  x - VMLAB_ICON_UNITS / 2, BUTTON_CENTRE_Y - VMLAB_ICON_UNITS / 2);
+}
