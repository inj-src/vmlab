+/* the bar's outline: its top corners round when the window is not maximized or tiled */
+static void
+title_bar_path(cairo_t *cr, double width, double height, double radius)
+{
+	cairo_new_path(cr);
+	cairo_move_to(cr, 0, height);
+	cairo_arc(cr, radius, radius, radius, M_PI, 1.5 * M_PI);
+	cairo_arc(cr, width - radius, radius, radius, 1.5 * M_PI, 2 * M_PI);
+	cairo_line_to(cr, width, height);
+	cairo_close_path(cr);
+}
+
+/* the whole bar: its buttons are drawn here, not as components of their own */
+static void
+draw_title_bar_content(struct libdecor_frame_cairo *frame_cairo,
+		       cairo_t *cr,
+		       int width,
+		       int scale)
+{
+	enum libdecor_window_state state =
+		libdecor_frame_get_window_state(&frame_cairo->frame);
+	bool active = state & LIBDECOR_WINDOW_STATE_ACTIVE;
+	const struct palette *palette = active ? &PALETTE_ACTIVE : &PALETTE_BACKDROP;
+	double radius =
+		frame_cairo->decoration_type == DECORATION_TYPE_ALL ? CORNER_RADIUS : 0;
+	int leftmost = button_centre_x(frame_cairo, BUTTON_FULLSCREEN) -
+		       (int)ROUND_BUTTON_RADIUS;
+
+	/* a light line along the top edge, the bar's grey from one row below it */
+	title_bar_path(cr, width, TITLE_HEIGHT, radius);
+	cairo_clip(cr);
+	set_grey(cr, palette->highlight, 1);
+	cairo_paint(cr);
+	cairo_save(cr);
+	cairo_translate(cr, 0, 1);
+	title_bar_path(cr, width, TITLE_HEIGHT, radius);
+	set_grey(cr, palette->bg, 1);
+	cairo_fill(cr);
+	cairo_restore(cr);
+	cairo_rectangle(cr, 0, TITLE_HEIGHT - 1, width, 1);
+	set_grey(cr, palette->border, 1);
 	cairo_fill(cr);
 
-	cairo_pattern_destroy(fade);
-	g_object_unref(layout);
+	draw_round_button(frame_cairo, cr, &frame_cairo->title_bar.fullscreen,
+			  vmlab_icon_fullscreen, palette, scale);
+
+	draw_window_button(frame_cairo, cr, &frame_cairo->title_bar.min,
+			   vmlab_icon_minimize, minimizable(frame_cairo),
+			   active, palette, scale);
+	draw_window_button(frame_cairo, cr, &frame_cairo->title_bar.max,
+			   (state & LIBDECOR_WINDOW_STATE_MAXIMIZED) ?
+				vmlab_icon_restore : vmlab_icon_maximize,
+			   resizable(frame_cairo), active, palette, scale);
+	draw_window_button(frame_cairo, cr, &frame_cairo->title_bar.close,
+			   vmlab_icon_close, closeable(frame_cairo),
+			   active, palette, scale);
+
+	draw_title_text(frame_cairo, cr, width, leftmost, palette);
 }
 
