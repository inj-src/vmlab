+/* vmlab: the save button's look changed (vmlab_save_wait): the bars drawn again */
+static void
+vmlab_save_redraw(struct libdecor_plugin_cairo *plugin_cairo)
+{
+	unsigned tick = atomic_load(&vmlab_save_tick);
+	struct libdecor_frame_cairo *frame_cairo;
+
+	if (tick == vmlab_save_drawn)
+		return;
+	vmlab_save_drawn = tick;
+	wl_list_for_each(frame_cairo, &plugin_cairo->visible_frame_list, link) {
+		if (!frame_cairo->title_bar.is_showing)
+			continue;
+		draw_title_bar(frame_cairo);
+		libdecor_frame_toplevel_commit(&frame_cairo->frame);
+	}
+}
