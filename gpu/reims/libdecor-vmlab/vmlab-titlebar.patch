+/* vmlab: the window can be hidden, through the pipe its program reads (VMLAB_WINDOW_CONTROL) */
+static bool
+vmlab_can_hide(void)
+{
+	const char *path = getenv("VMLAB_WINDOW_CONTROL");
+
+	return path && *path;
+}
+
+/* vmlab: the hide button's click: "hide" down the pipe, without waiting for a reader */
+static void
+vmlab_hide(void)
+{
+	int fd = open(getenv("VMLAB_WINDOW_CONTROL"), O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+
+	if (fd < 0) {
+		fprintf(stderr, "libdecor-cairo (vmlab): the window's control pipe: %s\n",
+			strerror(errno));
+		return;
+	}
+	if (write(fd, "hide\n", 5) != 5)
+		fprintf(stderr, "libdecor-cairo (vmlab): could not ask for the window to hide\n");
+	close(fd);
+}
+
+/*
+ * vmlab: the save button. A click runs VMLAB_SAVE_COMMAND through sh, its exit code coming
+ * back on a pipe (QEMU's own SIGCHLD handling may reap the child first). A thread of ours waits
+ * for it and sets the button's look; the bar is drawn on the main thread, where libdecor's
+ * dispatch runs: the thread wakes that loop with a round trip to the compositor (wl_display_sync)
+ * and the dispatch draws the bar again when vmlab_save_tick has changed. While the command runs
+ * the tick changes every 100 ms, a spinner frame each. Exit 0: a tick on the button for 4 s;
+ * exit 3 (cancelled, or a save already running): the save icon at once; any other: an error
+ * mark for 4 s. A click while it runs does nothing.
+ */
+enum vmlab_save_look { SAVE_IDLE, SAVE_RUNNING, SAVE_DONE, SAVE_FAILED };
+static atomic_int vmlab_save_look = SAVE_IDLE;
+static atomic_uint vmlab_save_tick;	/* changed: the bar is drawn again */
+static atomic_uint vmlab_save_click;	/* the click the look is of */
+static unsigned vmlab_save_drawn;	/* the tick last drawn (main thread) */
+static struct wl_display *vmlab_save_display;
+
+struct vmlab_save_run {
+	pid_t pid;
+	int fd;
+	unsigned click;
+};
+
+static bool
+vmlab_can_save(void)
+{
+	const char *command = getenv("VMLAB_SAVE_COMMAND");
+
+	return command && *command;
+}
+
+static void
+vmlab_save_woken(void *data, struct wl_callback *callback, uint32_t time)
+{
+	wl_callback_destroy(callback);
+}
+
+static const struct wl_callback_listener vmlab_save_wake_listener = {
+	vmlab_save_woken,
+};
+
+/* from our thread: the main loop draws the bar again (libwayland's requests are thread safe) */
+static void
+vmlab_save_wake(void)
+{
+	struct wl_callback *callback;
+
+	atomic_fetch_add(&vmlab_save_tick, 1);
+	callback = wl_display_sync(vmlab_save_display);
+	wl_callback_add_listener(callback, &vmlab_save_wake_listener, NULL);
+	wl_display_flush(vmlab_save_display);
+}
+
+static void *
+vmlab_save_wait(void *data)
+{
+	struct vmlab_save_run run = *(struct vmlab_save_run *) data;
+	struct pollfd pfd = { run.fd, POLLIN };
+	char code[16];
+	size_t got = 0;
+	ssize_t n;
+
+	free(data);
+	while (run.fd >= 0 && got < sizeof code - 1) {
+		int ready = poll(&pfd, 1, 100);
+
+		if (ready < 0 && errno != EINTR)
+			break;
+		if (ready > 0) {
+			n = read(run.fd, code + got, sizeof code - 1 - got);
+			if (n <= 0)
+				break;
+			got += n;
+			if (memchr(code, '\n', got))
+				break;
+		}
+		vmlab_save_wake();	/* a spinner frame */
+	}
+	if (run.fd >= 0) {
+		close(run.fd);
+		waitpid(run.pid, NULL, 0);
+	}
+	code[got] = 0;
+	if (got && atoi(code) == 3) {
+		atomic_store(&vmlab_save_look, SAVE_IDLE);
+		vmlab_save_wake();
+		return NULL;
+	}
+	atomic_store(&vmlab_save_look, got && atoi(code) == 0 ? SAVE_DONE : SAVE_FAILED);
+	vmlab_save_wake();
+	sleep(4);
+	if (atomic_load(&vmlab_save_click) == run.click) {
+		atomic_store(&vmlab_save_look, SAVE_IDLE);
+		vmlab_save_wake();
+	}
+	return NULL;
+}
+
+extern char **environ;
+
+/* the save button's click */
+static void
+vmlab_save(struct libdecor_frame_cairo *frame_cairo)
+{
+	/* the command's exit code on fd 3, which the command itself does not get */
+	static char *const argv[] = { "sh", "-c", "$VMLAB_SAVE_COMMAND 3>&-; echo $? >&3", NULL };
+	struct vmlab_save_run *run;
+	posix_spawn_file_actions_t files;
+	posix_spawnattr_t attr;
+	sigset_t none, all;
+	pthread_t thread;
+	int fds[2], err;
+
+	if (atomic_load(&vmlab_save_look) == SAVE_RUNNING)
+		return;
+	vmlab_save_display = libdecor_get_wl_display(frame_cairo->plugin_cairo->context);
+	run = zalloc(sizeof *run);
+	run->click = atomic_fetch_add(&vmlab_save_click, 1) + 1;
+	run->fd = -1;
+	atomic_store(&vmlab_save_look, SAVE_RUNNING);
+	if (pipe2(fds, O_CLOEXEC) == 0) {
+		/* none of QEMU's files, and none of its blocked or ignored signals */
+		posix_spawn_file_actions_init(&files);
+		posix_spawn_file_actions_addopen(&files, 0, "/dev/null", O_RDONLY, 0);
+		posix_spawn_file_actions_adddup2(&files, fds[1], 3);
+		posix_spawn_file_actions_addclosefrom_np(&files, 4);
+		posix_spawnattr_init(&attr);
+		sigemptyset(&none);
+		sigfillset(&all);
+		posix_spawnattr_setsigmask(&attr, &none);
+		posix_spawnattr_setsigdefault(&attr, &all);
+		posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF);
+		err = posix_spawn(&run->pid, "/bin/sh", &files, &attr, argv, environ);
+		posix_spawnattr_destroy(&attr);
+		posix_spawn_file_actions_destroy(&files);
+		close(fds[1]);
+		if (err == 0)
+			run->fd = fds[0];
+		else
+			close(fds[0]);
+	} else {
+		err = errno;
+	}
+	if (err)
+		fprintf(stderr, "libdecor-cairo (vmlab): the save command: %s\n", strerror(err));
+	/* without a command running, the thread shows the failure */
+	if (pthread_create(&thread, NULL, vmlab_save_wait, run) == 0)
+		pthread_detach(thread);
+	else
+		atomic_store(&vmlab_save_look, SAVE_FAILED);
+}
