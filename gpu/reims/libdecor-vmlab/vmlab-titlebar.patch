+/* in the title bar's own units, from its left edge */
+static int
+button_centre_x(struct libdecor_frame_cairo *frame_cairo, enum component component)
+{
+	int width = libdecor_frame_get_content_width(&frame_cairo->frame);
+
+	switch (component) {
+	case BUTTON_CLOSE:
+		return width - CLOSE_CENTRE;
+	case BUTTON_MAX:
+		return width - CLOSE_CENTRE - (int)BUTTON_WIDTH;
+	case BUTTON_MIN:
+		return width - CLOSE_CENTRE - 2 * (int)BUTTON_WIDTH;
+	case BUTTON_FULLSCREEN:
+		return width - FULLSCREEN_CENTRE;
+	default:
+		return 0;
+	}
+}
