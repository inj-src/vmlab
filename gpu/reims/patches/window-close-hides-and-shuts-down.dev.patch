+    #[test]
+    fn a_close_command_that_fails_powers_the_vm_off() {
+        use std::sync::mpsc;
+        use std::time::Duration;
+        let wait = Duration::from_secs(20);
+        let (said, hears) = mpsc::channel();
+        run_close_command("exit 0", move |why| said.send(why).unwrap()).unwrap();
+        // the thread ended without a word: the sender is dropped
+        assert_eq!(
+            hears.recv_timeout(wait),
+            Err(mpsc::RecvTimeoutError::Disconnected)
+        );
+        let (said, hears) = mpsc::channel();
+        run_close_command("exit 3", move |why| said.send(why).unwrap()).unwrap();
+        assert!(hears.recv_timeout(wait).unwrap().contains('3'));
+        let (said, hears) = mpsc::channel();
+        run_close_command("/nonexistent/vmlab-close", move |why| {
+            said.send(why).unwrap();
+        })
+        .unwrap();
+        assert!(hears.recv_timeout(wait).unwrap().contains("127"));
+    }
