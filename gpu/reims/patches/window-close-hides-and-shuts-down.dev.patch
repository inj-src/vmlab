+/// The command that shuts the guest down when the person closes a window (vmlab; Linux):
+/// `REIMS_VGPU_WINDOW_CLOSE_COMMAND`, a line for `/bin/sh -c`. The window hides and the command
+/// runs, in place of telling the host, which powers the VM off; the host is told only where the
+/// command cannot start or fails (`native::linux::sdl::shut_down_by`). Unset or blank: the host
+/// is told. Read once per process.
+pub fn close_command() -> Option<&'static str> {
+    static COMMAND: OnceLock<Option<String>> = OnceLock::new();
+    COMMAND
+        .get_or_init(|| parse_close_command(std::env::var(CLOSE_COMMAND_VAR).ok().as_deref()))
+        .as_deref()
+}
