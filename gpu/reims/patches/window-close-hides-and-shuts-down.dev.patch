+/// vmlab: the person closed the window: it leaves the screen at the click. Upstream keeps it
+/// open until QEMU's shutdown reaches the display, seconds later, and until then it shows its
+/// last frame and takes no input, which reads as a window that hung. SDL's window stays, for the
+/// render thread's surface under it, until the display's end ([`close`]).
+pub(crate) fn hide(shell: &mut Shell) {
+    // SAFETY: the window is SDL's, on this thread.
+    unsafe { SDL_HideWindow(shell.sdl) };
+}
+
+/// vmlab: starts the close command `command` (`crate::env::close_command`) for window `id`,
+/// which shuts the guest down: whether it started. Where it did not, the caller tells the host.
+/// Where it ends in anything but success, the host is told on the UI thread
+/// ([`shell::power_off`]), which powers the VM off: the command fails where the guest did not
+/// shut down (no way in to it, or still up when the command's time ran out).
+pub(crate) fn shut_down_by(command: &str, id: u64) -> bool {
+    let line = command.to_owned();
+    let started = run_close_command(command, move |why| {
+        log::warn!(
+            target: "reims_vgpu_window",
+            "close command {line:?} failed ({why}): powering the VM off"
+        );
+        super::ui::post(move || shell::power_off(id));
+    });
+    match started {
+        Ok(()) => {
+            log::info!(
+                target: "reims_vgpu_window",
+                "close command {command:?} shuts the guest down"
+            );
+            true
+        }
+        Err(error) => {
+            log::warn!(
+                target: "reims_vgpu_window",
+                "close command {command:?} did not start ({error}): powering the VM off"
+            );
+            false
+        }
+    }
+}
+
+/// Starts `command`, a line for `/bin/sh -c` with nothing to read and the process's own output
+/// (QEMU's log), and a thread that waits for it and calls `failed` with the reason where it ends
+/// in anything but success. An error where the command or the thread did not start.
+fn run_close_command(
+    command: &str,
+    failed: impl FnOnce(String) + Send + 'static,
+) -> std::io::Result<()> {
+    let mut child = std::process::Command::new("/bin/sh")
+        .arg("-c")
+        .arg(command)
+        .stdin(std::process::Stdio::null())
+        .spawn()?;
+    std::thread::Builder::new()
+        .name("reims-vgpu.close".into())
+        .spawn(move || match child.wait() {
+            Ok(status) if status.success() => {}
+            Ok(status) => failed(status.to_string()),
+            Err(error) => failed(error.to_string()),
+        })
+        .map(drop)
+}
