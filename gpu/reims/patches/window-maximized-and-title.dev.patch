+/// Whether a titled window opens maximized (vmlab; Linux): `REIMS_VGPU_WINDOW_MAXIMIZED` set to
+/// `1`, `true`, `yes` or `on`. The guest's mode stays what it is, and the window scales it. Read
+/// once per process.
+pub fn maximized() -> bool {
+    static MAXIMIZED: OnceLock<bool> = OnceLock::new();
+    *MAXIMIZED.get_or_init(|| std::env::var(MAXIMIZED_VAR).is_ok_and(|value| parse_switch(&value)))
