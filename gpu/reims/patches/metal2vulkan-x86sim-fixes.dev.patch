From a8bb3b499e14b0868b9b84a73bac052a32291a45 Mon Sep 17 00:00:00 2001
From: vmlab <vmlab@localhost>
Date: Fri, 27 Nov 2026 19:02:58 +0600
Subject: [PATCH] vmlab, from x86Sim (x86sim/metal2vulkan a980409c): no uvec4
 units for 16-byte leaves; a blob select may take a global's address

A 16-byte load declared align 16 can sit at a buffer bound at an offset of 4 mod 16 (x86Sim:
ASTC blocks, a magenta wallpaper): four aligned words read the right bytes at any 4-aligned
offset. And a select of blob pointers takes either side as a blob global's address
(MTLSimDriver's pvrtc4 decoder), as blob_ptr does for loads.
---
 crates/metal2vulkan/src/lower/access/blob.rs   | 14 +++++++-------
 crates/metal2vulkan/src/memory/leaf.rs         | 10 +++++++++-
 crates/metal2vulkan/src/tests/engine_access.rs |  3 +++
 3 files changed, 19 insertions(+), 8 deletions(-)

diff --git a/crates/metal2vulkan/src/lower/access/blob.rs b/crates/metal2vulkan/src/lower/access/blob.rs
index 1ed5aed..2003b9b 100644
--- a/crates/metal2vulkan/src/lower/access/blob.rs
+++ b/crates/metal2vulkan/src/lower/access/blob.rs
@@ -57,11 +57,11 @@ pub enum BlobStrategy {
     Copy {
         of: LocalPtr,
     },
-    /// `select c, t, f` of two blob pointers.
+    /// `select c, t, f` of two blob pointers; either may be a blob global's address itself.
     Select {
         c: ValueId,
-        t: ValueId,
-        f: ValueId,
+        t: LocalPtr,
+        f: LocalPtr,
     },
     Load(BlobLoad),
 }
@@ -250,8 +250,8 @@ pub fn select(
             use_blob(cx)?;
             BlobStrategy::Select {
                 c: operand(cx, *c)?,
-                t: operand(cx, *t)?,
-                f: operand(cx, *f)?,
+                t: blob_ptr(cx, *t)?,
+                f: blob_ptr(cx, *f)?,
             }
         }
         InstKind::Load {
@@ -357,8 +357,8 @@ pub fn emit(
         BlobStrategy::Copy { of } => ptr_value(cx, fb, *of)?,
         BlobStrategy::Select { c, t, f } => {
             let c = cx.operand(fb, *c)?;
-            let t = cx.operand(fb, *t)?;
-            let f = cx.operand(fb, *f)?;
+            let t = ptr_value(cx, fb, *t)?;
+            let f = ptr_value(cx, fb, *f)?;
             fb.select(c, t, f)?
         }
         BlobStrategy::Load(l) => {
diff --git a/crates/metal2vulkan/src/memory/leaf.rs b/crates/metal2vulkan/src/memory/leaf.rs
index 7a98412..2b221c9 100644
--- a/crates/metal2vulkan/src/memory/leaf.rs
+++ b/crates/metal2vulkan/src/memory/leaf.rs
@@ -271,6 +271,9 @@ impl Leaf {
     }
 }
 
+/// vmlab, from x86Sim (github.com/x86sim/metal2vulkan a980409c): whether 16-byte leaves may use `uvec4` units (see `leaf_of`).
+const VEC4_UNITS: bool = false;
+
 /// The leaf of an access of AIR type `ty` with alignment `align` bytes (1 when unstated), or the
 /// refusal of a type that is not a scalar or vector the arithmetic family holds on `p`. A
 /// vector's lanes must be whole bytes (`<N x i1>` and odd widths are bit-packed in LLVM); one of
@@ -330,7 +333,12 @@ pub fn leaf_of(
     ) {
         return Err(not_lowered());
     }
-    let path = if bytes == 16 && align >= 16 {
+    // vmlab, from x86Sim: no `uvec4` units. AIR's `align 16` promises a 16-aligned Metal address, but Apple GPUs
+    // load a 16-byte vector at any 4-aligned address and clients rely on it: MTLSimDriver's `astc`
+    // kernel reads `uint4` blocks from a buffer bound at a KTX mip's offset (4 mod 16), and the
+    // `uvec4` unit `(residual + m) / 16` dropped the residual's low bits (magenta wallpaper texture).
+    // Four aligned words read the same bytes at any 4-aligned offset.
+    let path = if bytes == 16 && align >= 16 && VEC4_UNITS {
         Path::Vec4
     } else if align >= 4 {
         Path::Aligned
