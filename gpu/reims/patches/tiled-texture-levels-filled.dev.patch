index 42cdd3ec..525756a0 100644
--- a/crates/reims-vgpu-vulkan/src/gpu/device.rs
+++ b/crates/reims-vgpu-vulkan/src/gpu/device.rs
@@ -194,6 +194,48 @@ pub struct DeviceObject {
     caps: OnceLock<Arc<DeviceCaps>>,
     /// Its keeping awake while the guest draws ([`crate::awake`]).
     pub(crate) awake: crate::awake::Awake,
+    /// The queue of the command buffers that fill a new tiled texture's smaller levels
+    /// ([`DeviceObject::fill_tiled_levels`]), made at the first; `None` where the runtime made
+    /// none.
+    tiled_levels: OnceLock<Option<rt::CommandQueue>>,
+}
+
+impl DeviceObject {
+    /// Fills the levels past the first of a new texture of more than one level over a buffer
+    /// (`newTiledTextureWithDescriptor:offset:bytesPerRow:`) from its first level, the buffer's
+    /// bytes as they lie now, in a command buffer of the device's own committed here.
+    ///
+    /// CoreAnimation counts on it. For an image a layer shows through a trilinear filter
+    /// (`minificationFilter = kCAFilterTrilinear`, as the Dock's badge labels have),
+    /// WindowServer makes the image's texture by the tiled form over the image's bytes, of the
+    /// extent's full chain of levels, samples it through a sampler whose mip filter is linear,
+    /// and generates no level itself: `CA::OGL::MetalContext::update_image` (QuartzCore, macOS
+    /// 26.7) calls its `generate_mipmaps_for_texture` on the path that uploads with
+    /// `replaceRegion:` alone, and returns before it where `copy_image_to_texture` made the
+    /// tiled texture. With the levels left as the runtime makes them (zero), every such layer
+    /// drawn smaller than its image samples transparent texels: the Dock's badges show no
+    /// number. What an x86 Mac's driver does there is not measured (no such Mac is on hand);
+    /// a guest that writes the levels itself afterwards overwrites these.
+    pub(crate) fn fill_tiled_levels(&self, texture: &rt::Texture) {
+        if texture.mipmap_level_count() < 2 {
+            return;
+        }
+        let queue = self
+            .tiled_levels
+            .get_or_init(|| self.raw.new_command_queue().ok());
+        let Some(queue) = queue else {
+            return;
+        };
+        let filled = queue.command_buffer().and_then(|commands| {
+            let mut blit = commands.blit_command_encoder()?;
+            blit.generate_mipmaps(texture)?;
+            blit.end_encoding()?;
+            crate::core::platform::command::committing(|| commands.commit())
+        });
+        if let Err(e) = filled {
+            log::warn!("a tiled texture's levels past the first were not filled: {e:?}");
+        }
+    }
 }
 
