+/// vmlab: the window shows on request (`super::control`), raised, so it comes up over the others
+/// and the compositor may give it the keyboard.
+pub(crate) fn show(shell: &mut Shell) {
+    // SAFETY: the window is SDL's, on this thread.
+    unsafe {
+        SDL_ShowWindow(shell.sdl);
+        SDL_RaiseWindow(shell.sdl);
+    }
+}
+
+/// vmlab: records that the windows show or not after a request (`super::control`).
+pub(crate) fn requested(shown: bool) {
+    super::control::set_shown(shown);
+}
