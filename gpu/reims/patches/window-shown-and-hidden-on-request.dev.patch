+/// vmlab (Linux): shows or hides every open window on request
+/// (`crate::native::linux::control`). A window the person closed, or whose display ended, stays
+/// hidden. A shown one is drawn again once SDL says it shows ([`batch_over`]); a hidden one stops
+/// being drawn at once.
+#[cfg(target_os = "linux")]
+pub(crate) fn show_on_request(show: bool) {
+    let ids = each_open(|s| (!s.closed && !s.leaving).then(|| s.window.id()));
+    for id in ids {
+        with_shell(id, |shell| {
+            if show {
+                os::show(shell);
+            } else {
+                shell.window.surface().set_visible(false);
+                os::hide(shell);
+            }
+        });
+    }
+    os::requested(show);
+}
+
