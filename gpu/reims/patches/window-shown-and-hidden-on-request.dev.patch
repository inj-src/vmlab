diff --git a/crates/reims-vgpu-window/src/native/linux/control.rs b/crates/reims-vgpu-window/src/native/linux/control.rs
new file mode 100644
index 00000000..72a92bf7
--- /dev/null
+++ b/crates/reims-vgpu-window/src/native/linux/control.rs
@@ -0,0 +1,105 @@
+//! vmlab: the windows shown and hidden on request, so a VM started without anyone watching can be
+//! shown later in its real window, and hidden again with the VM still running.
+//!
+//! `VMLAB_WINDOW_CONTROL` names a FIFO whose lines `show` and `hide` show or hide every window of
+//! the process (`crate::sdl::shell::show_on_request`); the title bar's hide button (the lab's
+//! libdecor plugin, in this process) writes `hide` to the same FIFO. `VMLAB_WINDOW_STATE_FILE`
+//! gets `shown` or `hidden` as a window opens and after each request, for the lab's `vm` to read.
+//! With `REIMS_VGPU_WINDOW_HIDDEN` the windows open hidden (`crate::env::hidden`).
+//!
+//! While no window shows, no clipboard is shared (`super::agent`): nobody is looking at the VM,
+//! and the guest has no business reading the host's clipboard or setting it.
+//!
+//! A reader thread opens the FIFO for reading and writing, so it never reads an end when a
+//! writer closes, and posts each request to the UI thread.
+
+use std::io::{BufRead, BufReader};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use super::ui;
+use crate::sdl::shell;
+
+/// The control FIFO's variable.
+const CONTROL_VAR: &str = "VMLAB_WINDOW_CONTROL";
+/// The state file's variable.
+const STATE_VAR: &str = "VMLAB_WINDOW_STATE_FILE";
+
+/// Whether the windows show, as last opened or asked.
+static SHOWN: AtomicBool = AtomicBool::new(false);
+
+/// Whether the windows show (the module doc).
+pub(crate) fn shown() -> bool {
+    SHOWN.load(Ordering::Relaxed)
+}
+
+/// Records whether the windows show, in [`SHOWN`] and the state file.
+pub(crate) fn set_shown(shown: bool) {
+    SHOWN.store(shown, Ordering::Relaxed);
+    let Some(path) = std::env::var_os(STATE_VAR).filter(|path| !path.is_empty()) else {
+        return;
+    };
+    if let Err(error) = std::fs::write(&path, if shown { "shown\n" } else { "hidden\n" }) {
+        log::warn!(target: "reims_vgpu_window", "vmlab: the window's state file: {error}");
+    }
+}
+
+/// What a control line asks: to show the windows (`true`) or hide them (`false`); `None` for
+/// anything else.
+fn request(line: &str) -> Option<bool> {
+    match line.trim() {
+        "show" => Some(true),
+        "hide" => Some(false),
+        _ => None,
+    }
+}
+
+/// Starts the reader thread where `VMLAB_WINDOW_CONTROL` names a FIFO (the module doc). On the
+/// UI thread, once SDL's video runs.
+pub(crate) fn start() {
+    let Some(path) = std::env::var_os(CONTROL_VAR).filter(|path| !path.is_empty()) else {
+        return;
+    };
+    let spawned = std::thread::Builder::new()
+        .name("vmlab.window-control".into())
+        .spawn(move || {
+            let fifo = match std::fs::OpenOptions::new().read(true).write(true).open(&path) {
+                Ok(fifo) => fifo,
+                Err(error) => {
+                    log::warn!(
+                        target: "reims_vgpu_window",
+                        "vmlab: no window control ({}: {error})",
+                        path.display()
+                    );
+                    return;
+                }
+            };
+            for line in BufReader::new(fifo).lines() {
+                let Ok(line) = line else { return };
+                match request(&line) {
+                    Some(show) => ui::post(move || shell::show_on_request(show)),
+                    None => log::warn!(
+                        target: "reims_vgpu_window",
+                        "vmlab: window control: {line:?} is neither show nor hide"
+                    ),
+                }
+            }
+        });
+    if let Err(error) = spawned {
+        log::warn!(target: "reims_vgpu_window", "vmlab: no window control thread: {error}");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A control line is `show` or `hide`, blanks around it allowed; anything else asks nothing
+    #[test]
+    fn a_control_line_is_show_or_hide() {
+        assert_eq!(request("show"), Some(true));
+        assert_eq!(request(" hide \r"), Some(false));
+        assert_eq!(request(""), None);
+        assert_eq!(request("Show"), None);
+        assert_eq!(request("shown"), None);
+    }
+}
