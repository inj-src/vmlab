+/// The mode the display offers while no window shows (vmlab; Linux): `REIMS_VGPU_WINDOW_HIDDEN_MODE`
+/// as `WxH` (`1920x1080`), whatever the windows' sizes, so a VM nobody looks at keeps the pixels an
+/// agent's clicks expect. Shown again, a window pins its pixels again (`REIMS_VGPU_WINDOW_MODE=first`,
+/// [`Pin`]). `None` where unset or not a size. Read once per process.
+pub fn hidden_mode() -> Option<(u32, u32)> {
+    static MODE: OnceLock<Option<(u32, u32)>> = OnceLock::new();
+    *MODE.get_or_init(
+        || match parse_pinned_mode(std::env::var(HIDDEN_MODE_VAR).ok().as_deref()) {
+            PinnedMode::Fixed(width, height) => Some((u32::from(width), u32::from(height))),
+            PinnedMode::First | PinnedMode::Follows => None,
+        },
+    )
+}
