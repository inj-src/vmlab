+/// Which mode a window that keeps its size offers the guest (vmlab; `REIMS_VGPU_WINDOW_MODE`).
+/// Pinned, a resize of the window changes nothing for the guest: the window fits the guest's
+/// image into its new size, scaled, between black bars.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum PinnedMode {
+    /// The window's size, each time it changes: unset, or a value that is neither of the others.
+    #[default]
+    Follows,
+    /// The mode of the guest's first scanout, which is the window's size as it opened, from then
+    /// on: `first`. The image is a guest pixel to a pixel until the person resizes the window.
+    First,
+    /// This mode, width then height, always: `1920x1080`.
+    Fixed(u16, u16),
+}
+
+/// The pinned mode a value names: `first`, or `WxH` in pixels, each side at least 1; in any case,
+/// spaces aside.
+pub fn parse_pinned_mode(value: Option<&str>) -> PinnedMode {
+    let Some(value) = value.map(|value| value.trim().to_ascii_lowercase()) else {
+        return PinnedMode::Follows;
+    };
+    if value == "first" {
+        return PinnedMode::First;
+    }
+    let side = |side: &str| side.trim().parse::<u16>().ok().filter(|side| *side > 0);
+    match value.split_once('x') {
+        Some((width, height)) => match (side(width), side(height)) {
+            (Some(width), Some(height)) => PinnedMode::Fixed(width, height),
+            _ => PinnedMode::Follows,
+        },
+        None => PinnedMode::Follows,
+    }
+}
+
+/// What an open window last measured of itself, for a pinned mode taken from the window
+/// (vmlab; [`PinnedMode::First`], [`Pin`]).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Measured {
+    /// Its content's size in pixels.
+    pub pixels: (u32, u32),
+    /// Its screen's scale as the window system tells it (1.25 on a 125% Wayland screen).
+    pub scale: f64,
+    /// Whether it is maximized or full screen: the size it was opened to have.
+    pub fills: bool,
+}
+
+/// How long a window's measures stay the same before a mode is pinned from them: a move between
+/// screens changes the scale first and the size after.
+pub const PIN_SETTLE: Duration = Duration::from_millis(400);
+
+/// The mode a display is pinned at (vmlab; [`PinnedMode`]). For [`PinnedMode::First`] it is the
+/// pixels of the window while it fills its screen, taken once per screen scale: on a screen of
+/// another scale the guest's pixels would be stretched, so the mode is taken again there, once
+/// the window fills that screen and has kept its measures for [`PIN_SETTLE`]. A window that does
+/// not fill its screen never changes the mode.
+#[derive(Debug, Default)]
+pub struct Pin {
+    /// The pinned mode, once there is one.
+    size: Option<(u32, u32)>,
+    /// The scale `size` was measured at, as bits; `None` for a size that was not measured.
+    scale: Option<u64>,
+    /// Measures that would change the mode, and when they were first seen.
+    steady: Option<(Measured, Instant)>,
+}
+
+impl Pin {
+    /// A mode pinned from the start.
+    pub fn fixed(width: u32, height: u32) -> Self {
+        Self {
+            size: Some((width, height)),
+            ..Self::default()
+        }
+    }
+
+    /// The pinned mode, once there is one.
+    pub fn size(&self) -> Option<(u32, u32)> {
+        self.size
+    }
+
+    /// The guest set a mode: it is the pinned one where nothing was pinned yet (a window that
+    /// never filled its screen).
+    pub fn guest_set(&mut self, width: u32, height: u32) {
+        self.size.get_or_insert((width, height));
+    }
+
+    /// The window measures `measured` at `now`: the pinned mode after it. The mode is
+    /// `rounded(pixels)`, the mode a display offers for a window of those pixels.
+    pub fn measured(
+        &mut self,
+        measured: Option<Measured>,
+        now: Instant,
+        rounded: impl FnOnce((u32, u32)) -> (u32, u32),
+    ) -> Option<(u32, u32)> {
+        let wanted = measured.filter(|m| m.fills && self.scale != Some(m.scale.to_bits()));
+        match (wanted, self.steady) {
+            (Some(m), Some((seen, since))) if seen == m => {
+                if now.duration_since(since) >= PIN_SETTLE {
+                    self.size = Some(rounded(m.pixels));
+                    self.scale = Some(m.scale.to_bits());
+                    self.steady = None;
+                }
+            }
+            (Some(m), _) => self.steady = Some((m, now)),
+            (None, _) => self.steady = None,
+        }
+        self.size
+    }
+}
+
+/// The process's pinned mode ([`MODE_VAR`]). Read once per process.
+pub fn pinned_mode() -> PinnedMode {
+    static MODE: OnceLock<PinnedMode> = OnceLock::new();
+    *MODE.get_or_init(|| parse_pinned_mode(std::env::var(MODE_VAR).ok().as_deref()))
+}
 
