+    /// vmlab: tells the window its pixels, its screen's scale and whether it fills its screen
+    /// (`crate::env::Measured`), which a mode pinned from the window is taken from.
+    fn measure(&self) {
+        let (mut width, mut height) = (0, 0);
+        // SAFETY: the window is SDL's, on this thread.
+        let (scale, flags) = unsafe {
+            SDL_GetWindowSizeInPixels(self.sdl, &mut width, &mut height);
+            (
+                SDL_GetWindowDisplayScale(self.sdl),
+                SDL_GetWindowFlags(self.sdl),
+            )
+        };
+        let (Ok(width), Ok(height)) = (u32::try_from(width), u32::try_from(height)) else {
+            return;
+        };
+        if width == 0 || height == 0 || !(scale > 0.0) {
+            return;
+        }
+        let fills = (flags.0 & (SDL_WINDOW_MAXIMIZED.0 | SDL_WINDOW_FULLSCREEN.0)) != 0;
+        self.window.set_measured(crate::env::Measured {
+            pixels: (width, height),
+            scale: f64::from(scale),
+            fills,
+        });
+    }
