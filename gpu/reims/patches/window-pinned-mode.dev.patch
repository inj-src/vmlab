+    /// The pinned mode is `first` or a size; anything else follows the window
+    #[test]
+    fn the_pinned_mode_is_first_or_a_size() {
+        assert_eq!(parse_pinned_mode(None), PinnedMode::Follows);
+        for first in ["first", " First ", "FIRST"] {
+            assert_eq!(
+                parse_pinned_mode(Some(first)),
+                PinnedMode::First,
+                "{first:?}"
+            );
+        }
+        assert_eq!(
+            parse_pinned_mode(Some("1920x1080")),
+            PinnedMode::Fixed(1920, 1080)
+        );
+        assert_eq!(
+            parse_pinned_mode(Some(" 2560 X 1440 ")),
+            PinnedMode::Fixed(2560, 1440)
+        );
+        for other in [
+            "", "1", "on", "1920", "1920x", "x1080", "0x1080", "1920x0", "ax1",
+        ] {
+            assert_eq!(
+                parse_pinned_mode(Some(other)),
+                PinnedMode::Follows,
+                "{other:?}"
+            );
+        }
+    }
+
+    /// A window that fills its screen pins its pixels once they are steady, and again on a screen
+    /// of another scale; a window that does not fill its screen changes nothing
+    #[test]
+    fn the_first_mode_is_the_filling_window_s_per_scale() {
+        let same = |pixels| pixels;
+        let at = |pixels, scale, fills| {
+            Some(Measured {
+                pixels,
+                scale,
+                fills,
+            })
+        };
+        let start = Instant::now();
+        let later = |ms| start + Duration::from_millis(ms);
+        let mut pin = Pin::default();
+        assert_eq!(pin.measured(None, start, same), None);
+        // opening: not maximized yet
+        assert_eq!(pin.measured(at((1446, 816), 1.0, false), start, same), None);
+        assert_eq!(pin.measured(at((1920, 1056), 1.0, true), later(10), same), None);
+        assert_eq!(pin.measured(at((1920, 1056), 1.0, true), later(300), same), None);
+        assert_eq!(
+            pin.measured(at((1920, 1056), 1.0, true), later(410), same),
+            Some((1920, 1056))
+        );
+        // restored and resized on the same screen: the mode stays
+        assert_eq!(
+            pin.measured(at((800, 600), 1.0, false), later(1000), same),
+            Some((1920, 1056))
+        );
+        // maximized again at another size, same scale: it stays too
+        assert_eq!(
+            pin.measured(at((1920, 1080), 1.0, true), later(3000), same),
+            Some((1920, 1056))
+        );
+        // dragged to a 125% screen, not maximized: it stays
+        assert_eq!(
+            pin.measured(at((1000, 750), 1.25, false), later(4000), same),
+            Some((1920, 1056))
+        );
+        // maximized there: the scale comes before the size, and each change starts the wait again
+        assert_eq!(
+            pin.measured(at((2400, 1320), 1.25, true), later(5000), same),
+            Some((1920, 1056))
+        );
+        assert_eq!(
+            pin.measured(at((1920, 1050), 1.25, true), later(5300), same),
+            Some((1920, 1056))
+        );
+        assert_eq!(
+            pin.measured(at((1920, 1050), 1.25, true), later(5600), same),
+            Some((1920, 1056))
+        );
+        assert_eq!(
+            pin.measured(at((1920, 1050), 1.25, true), later(5700), |(w, h)| (w - 16, h)),
+            Some((1904, 1050))
+        );
+        assert_eq!(
+            pin.measured(at((1920, 1050), 1.25, true), later(9000), same),
+            Some((1904, 1050))
+        );
+    }
+
+    /// A fixed mode stays, and the guest's own first mode is pinned only where none was
