+/// A drag's files were dropped on the window: the drop command takes them from here, with its
+/// own output (QEMU's log) and a thread that waits for it. What becomes of the files is the
+/// command's to tell the person; here it is only logged.
+fn dropped(paths: Vec<PathBuf>) {
+    let Some(command) = drop_command() else {
+        return;
+    };
+    let count = paths.len();
+    let spawned = std::process::Command::new("/bin/sh")
+        .arg("-c")
+        .arg(format!("{command} \"$@\""))
+        .arg("vmlab-drop")
+        .args(&paths)
+        .stdin(std::process::Stdio::null())
+        .spawn()
+        .and_then(|mut child| {
+            std::thread::Builder::new()
+                .name("vmlab.drop".into())
+                .spawn(move || match child.wait() {
+                    Ok(status) if status.success() => {
+                        log::info!(target: "reims_vgpu_window", "vmlab file drop: {count} taken by the drop command");
+                    }
+                    Ok(status) => {
+                        log::warn!(target: "reims_vgpu_window", "vmlab file drop: the drop command failed ({status})");
+                    }
+                    Err(error) => {
+                        log::warn!(target: "reims_vgpu_window", "vmlab file drop: the drop command was lost ({error})");
+                    }
+                })
+        });
+    if let Err(error) = spawned {
+        log::warn!(
+            target: "reims_vgpu_window",
+            "vmlab file drop: {} and {} more not sent: the drop command did not start ({error})",
+            paths[0].display(),
+            count - 1
+        );
+    }
+}
