+/// The host's clipboard, read from whoever holds it.
+fn read_host() -> Clip {
+    let mut clip = Clip::default();
+    // SAFETY: SDL's video runs on this thread; what SDL returns is freed with SDL_free.
+    unsafe {
+        if SDL_HasClipboardText() {
+            let text = SDL_GetClipboardText();
+            if !text.is_null() {
+                let bytes = CStr::from_ptr(text).to_bytes();
+                if !bytes.is_empty() && bytes.len() < MAX_MESSAGE - 64 {
+                    clip.text = Some(bytes.to_vec());
+                }
+                SDL_free(text.cast());
+            }
+        }
+        if SDL_HasClipboardData(PNG_MIME.as_ptr()) {
+            let mut size = 0usize;
+            let data = SDL_GetClipboardData(PNG_MIME.as_ptr(), &mut size);
+            if !data.is_null() {
+                if size > 0 && size < MAX_MESSAGE - 64 {
+                    clip.png = Some(std::slice::from_raw_parts(data.cast::<u8>(), size).to_vec());
+                }
+                SDL_free(data);
+            }
+        }
+    }
+    clip
+}
