+//! vmlab: the host's clipboard (text and pictures) shared with the guest through a SPICE agent
+//! in the guest, and files dropped on the window handed to a command that carries them there.
+//!
+//! QEMU gives the guest a virtio serial port named `com.redhat.spice.0` whose other end is a
+//! Unix socket QEMU listens on; `VMLAB_AGENT_SOCKET` names it. This module is the "client" a
+//! SPICE agent talks to (spice-protocol's `vd_agent.h`): chunks `{u32 port, u32 size}` of at
+//! most 2048 bytes, whose payloads joined are messages `{u32 protocol, u32 type, u64 opaque,
+//! u32 size}` and their data, all little-endian. Without the variable no clipboard is shared.
+//!
+//! **Threads.** A reader thread connects, reads messages and posts each to the UI thread; a
+//! writer thread writes what the UI thread queues, so a guest that reads nothing stalls only
+//! that thread. The clipboard is SDL's, which is the UI thread's, and Wayland gives the
+//! clipboard only to the program whose window has the keyboard: hence in this process.
+//!
+//! **Host to guest.** When the host's clipboard changes while the window has the keyboard
+//! (`SDL_EVENT_CLIPBOARD_UPDATE`), its text and PNG are read at once and offered (`GRAB`); the
+//! guest's requests are answered from that copy. Wayland tells of the clipboard again each time
+//! the window gains the keyboard, so a clipboard already shared (by its hash) is not offered
+//! twice, which is also what keeps the guest's own copy from coming back to it.
+//!
+//! **Guest to host.** On the guest's `GRAB` its text and PNG are requested, one at a time (a
+//! reply names no request), and given to SDL when all are in.
+//!
+//! **Files.** The files and folders of one drag onto the window (`SDL_EVENT_DROP_FILE` for
+//! each, then `SDL_EVENT_DROP_COMPLETE`) are given to the command `VMLAB_DROP_COMMAND` names, a
+//! line for `/bin/sh -c` that gets their paths as its arguments and puts them on the guest's
+//! desktop its own way (the lab's goes through SSH). They do not go through the agent: macOS
+//! stops reading its serial port some tens of megabytes into a large file, and the clipboard
+//! stops with it. Without the variable a drop is only logged.
+
+use std::cell::RefCell;
+use std::collections::VecDeque;
+use std::ffi::{CStr, c_char, c_void};
+use std::hash::{Hash, Hasher};
+use std::io::{Read, Write};
+use std::os::unix::net::UnixStream;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+use std::sync::mpsc::{self, Receiver, Sender};
+use std::time::{Duration, Instant};
+
+use sdl3_sys::everything::*;
+
+use super::ui;
+
+/// The chunk port of a client's messages (`VDP_CLIENT_PORT`).
+const CLIENT_PORT: u32 = 1;
+/// `VD_AGENT_PROTOCOL`.
+const PROTOCOL: u32 = 1;
+/// The most bytes a chunk carries (`VD_AGENT_MAX_DATA_SIZE`).
+const CHUNK: usize = 2048;
+/// The largest message taken or sent: a larger clipboard is not shared.
+const MAX_MESSAGE: usize = 64 << 20;
+/// How long a clipboard request may go unanswered before a newer offer replaces it.
+const REPLY_WAIT: Duration = Duration::from_secs(10);
+/// How long before the socket is tried again.
+const RETRY: Duration = Duration::from_secs(2);
+
+const MSG_CLIPBOARD: u32 = 4;
+const MSG_ANNOUNCE: u32 = 6;
+const MSG_GRAB: u32 = 7;
+const MSG_REQUEST: u32 = 8;
+const MSG_RELEASE: u32 = 9;
+const MSG_MAX_CLIPBOARD: u32 = 14;
+
+const TYPE_TEXT: u32 = 1;
+const TYPE_PNG: u32 = 2;
+
+/// What this side can do: clipboard by demand (5), a clipboard size limit (10), no release
+/// before a new offer (16).
+const CAPS: u32 = 1 << 5 | 1 << 10 | 1 << 16;
+
+const PNG_MIME: &CStr = c"image/png";
+/// The names text is offered under, the first being the one asked of others.
+const TEXT_MIMES: [&CStr; 5] = [
+    c"text/plain;charset=utf-8",
+    c"text/plain",
+    c"UTF8_STRING",
+    c"STRING",
+    c"TEXT",
+];
+
+/// What the writer thread writes: a message's type and its data.
+type Out = (u32, Vec<u8>);
+
+/// A clipboard's content in the two forms shared.
+#[derive(Default, Hash)]
+struct Clip {
+    text: Option<Vec<u8>>,
+    png: Option<Vec<u8>>,
+}
+
+impl Clip {
+    fn is_empty(&self) -> bool {
+        self.text.is_none() && self.png.is_none()
+    }
+
+    fn types(&self) -> Vec<u32> {
+        let mut types = Vec::new();
+        if self.text.is_some() {
+            types.push(TYPE_TEXT);
+        }
+        if self.png.is_some() {
+            types.push(TYPE_PNG);
+        }
+        types
+    }
+
+    fn get(&self, kind: u32) -> Option<&Vec<u8>> {
+        match kind {
+            TYPE_TEXT => self.text.as_ref(),
+            TYPE_PNG => self.png.as_ref(),
+            _ => None,
+        }
+    }
+
+    fn digest(&self) -> u64 {
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        self.hash(&mut hasher);
+        hasher.finish()
+    }
+}
+
+/// The UI thread's side of the link, while the socket is connected.
+struct Link {
+    out: Sender<Out>,
+    /// Whether the agent has spoken: nothing but the greeting is sent before.
+    agent: bool,
+    /// The host's clipboard as last read, which the guest's requests are answered from.
+    host: Clip,
+    /// The digest of the clipboard both sides last had.
+    shared: Option<u64>,
+    /// The guest's clipboard as given to SDL, which reads it when a program pastes.
+    guest: Clip,
+    /// The types of the guest's current offer still to request.
+    wanted: VecDeque<u32>,
+    /// The guest's current offer as fetched so far; none when no offer is being fetched.
+    fetched: Option<Clip>,
+    /// The request awaiting its reply: its type, whether the reply is for the current offer, and
+    /// when it was sent.
+    asked: Option<(u32, bool, Instant)>,
+}
+
+thread_local! {
+    /// The link, on the UI thread.
+    static LINK: RefCell<Option<Link>> = const { RefCell::new(None) };
+    /// The paths of the drag being dropped, until its `SDL_EVENT_DROP_COMPLETE`.
+    static DROPPED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The command dropped files are given to: `VMLAB_DROP_COMMAND`, a line for `/bin/sh -c`. Read
+/// once per process; none where it is unset or blank.
+fn drop_command() -> Option<&'static str> {
+    static COMMAND: OnceLock<Option<String>> = OnceLock::new();
+    COMMAND
+        .get_or_init(|| {
+            std::env::var("VMLAB_DROP_COMMAND")
+                .ok()
+                .map(|line| line.trim().to_owned())
+                .filter(|line| !line.is_empty())
+        })
+        .as_deref()
+}
+
+/// Takes dropped files where `VMLAB_DROP_COMMAND` names their command, and starts the link where
+/// `VMLAB_AGENT_SOCKET` names its socket. Called once, on the UI thread.
+pub(crate) fn start() {
+    if drop_command().is_some() {
+        // SAFETY: SDL's video runs on this thread.
+        unsafe {
+            SDL_SetEventEnabled(SDL_EVENT_DROP_FILE.into(), true);
+            SDL_SetEventEnabled(SDL_EVENT_DROP_COMPLETE.into(), true);
+        }
+    }
+    let Some(path) = std::env::var_os("VMLAB_AGENT_SOCKET").filter(|path| !path.is_empty()) else {
+        return;
+    };
+    // SAFETY: as above.
+    unsafe { SDL_SetEventEnabled(SDL_EVENT_CLIPBOARD_UPDATE.into(), true) };
+    let path = PathBuf::from(path);
+    let spawned = std::thread::Builder::new()
+        .name("vmlab.agent-read".into())
+        .spawn(move || {
+            loop {
+                if let Ok(stream) = UnixStream::connect(&path) {
+                    serve(stream);
+                    ui::post(|| LINK.with(|link| *link.borrow_mut() = None));
+                }
+                std::thread::sleep(RETRY);
+            }
+        });
+    if let Err(error) = spawned {
+        log::warn!(target: "reims_vgpu_window", "vmlab agent link: no thread: {error}");
+    }
+}
+
+/// An SDL event the link takes: whether it was one.
+pub(crate) fn event(event: &SDL_Event) -> bool {
+    // SAFETY: every event starts with its type, and each arm reads the variant its type names.
+    let kind = unsafe { event.r#type };
+    if kind == SDL_EVENT_CLIPBOARD_UPDATE.0 {
+        with_link(host_changed);
+        true
+    } else if kind == SDL_EVENT_DROP_FILE.0 {
+        // SAFETY: a drop event, whose data is a string SDL keeps while the event is handled.
+        let data = unsafe { event.drop.data };
+        if !data.is_null() {
+            // SAFETY: as above.
+            let path = unsafe { CStr::from_ptr(data) };
+            let path = PathBuf::from(<std::ffi::OsStr as std::os::unix::ffi::OsStrExt>::from_bytes(path.to_bytes()));
+            DROPPED.with(|dropped| dropped.borrow_mut().push(path));
+        }
+        true
+    } else if kind == SDL_EVENT_DROP_COMPLETE.0 {
+        let paths = DROPPED.with(|dropped| std::mem::take(&mut *dropped.borrow_mut()));
+        if !paths.is_empty() {
+            dropped(paths);
+        }
+        true
+    } else {
+        (SDL_EVENT_DROP_FILE.0..=SDL_EVENT_DROP_POSITION.0).contains(&kind)
+    }
+}
+
+/// Runs `body` on the link, where there is one.
+fn with_link(body: impl FnOnce(&mut Link)) {
+    LINK.with(|link| {
+        if let Ok(mut link) = link.try_borrow_mut() {
+            if let Some(link) = link.as_mut() {
+                body(link);
+            }
+        }
+    });
+}
+
+/// The reader thread's work on one connection, until it ends.
+fn serve(mut stream: UnixStream) {
+    let Ok(writer) = stream.try_clone() else {
+        return;
+    };
+    let (out, queue) = mpsc::channel();
+    if std::thread::Builder::new()
+        .name("vmlab.agent-write".into())
+        .spawn(move || write_all(writer, &queue))
+        .is_err()
+    {
+        return;
+    }
+    ui::post(move || {
+        // The greeting asks the agent for its own: an agent already running answers it, and
+        // one that starts later sends its own first.
+        let _ = out.send((MSG_ANNOUNCE, words(&[1, CAPS])));
+        LINK.with(|link| {
+            *link.borrow_mut() = Some(Link {
+                out,
+                agent: false,
+                host: Clip::default(),
+                shared: None,
+                guest: Clip::default(),
+                wanted: VecDeque::new(),
+                fetched: None,
+                asked: None,
+            });
+        });
+    });
+    let mut pending = Vec::new();
+    // Bytes of a message too large to take, still to pass over.
+    let mut skip = 0usize;
+    loop {
+        let mut header = [0u8; 8];
+        if stream.read_exact(&mut header).is_err() {
+            return;
+        }
+        let size = u32_at(&header, 4) as usize;
+        if size > 64 * CHUNK {
+            log::warn!(target: "reims_vgpu_window", "vmlab agent link: a chunk of {size} bytes: reconnecting");
+            return;
+        }
+        let start = pending.len();
+        pending.resize(start + size, 0);
+        if stream.read_exact(&mut pending[start..]).is_err() {
+            return;
+        }
+        loop {
+            if skip > 0 {
+                let passed = skip.min(pending.len());
+                pending.drain(..passed);
+                skip -= passed;
+                if skip > 0 {
+                    break;
+                }
+            }
+            if pending.len() < 20 {
+                break;
+            }
+            let (kind, size) = (u32_at(&pending, 4), u32_at(&pending, 16) as usize);
+            if size > MAX_MESSAGE {
+                pending.drain(..20);
+                skip = size;
+                continue;
+            }
+            if pending.len() < 20 + size {
+                break;
+            }
+            let data = pending[20..20 + size].to_vec();
+            pending.drain(..20 + size);
+            ui::post(move || with_link(|link| message(link, kind, &data)));
+        }
+    }
+}
+
+/// The writer thread's work: what is queued, in order, until the socket or the queue ends.
+fn write_all(mut stream: UnixStream, queue: &Receiver<Out>) {
+    while let Ok((kind, data)) = queue.recv() {
+        if write_message(&mut stream, kind, &data).is_err() {
+            let _ = stream.shutdown(std::net::Shutdown::Both);
+            return;
+        }
+    }
+}
+
+/// Writes one message as its chunks.
+fn write_message(stream: &mut UnixStream, kind: u32, data: &[u8]) -> std::io::Result<()> {
+    let mut message = Vec::with_capacity(20 + data.len());
+    message.extend_from_slice(&PROTOCOL.to_le_bytes());
+    message.extend_from_slice(&kind.to_le_bytes());
+    message.extend_from_slice(&0u64.to_le_bytes());
+    message.extend_from_slice(&(data.len() as u32).to_le_bytes());
+    message.extend_from_slice(data);
+    let mut wire = Vec::with_capacity(message.len() + 8 * message.len().div_ceil(CHUNK));
+    for chunk in message.chunks(CHUNK) {
+        wire.extend_from_slice(&CLIENT_PORT.to_le_bytes());
+        wire.extend_from_slice(&(chunk.len() as u32).to_le_bytes());
+        wire.extend_from_slice(chunk);
+    }
+    stream.write_all(&wire)
+}
+
+/// A message from the agent, on the UI thread.
+fn message(link: &mut Link, kind: u32, data: &[u8]) {
+    match kind {
+        MSG_ANNOUNCE => {
+            // The agent (re)started: nothing asked of the one before will be answered.
+            link.agent = true;
+            link.wanted.clear();
+            link.fetched = None;
+            link.asked = None;
+            if data.len() >= 4 && u32_at(data, 0) != 0 {
+                send(link, MSG_ANNOUNCE, words(&[0, CAPS]));
+            }
+            send(link, MSG_MAX_CLIPBOARD, words(&[(MAX_MESSAGE - 64) as u32]));
+            link.shared = None;
+            host_changed(link);
+        }
+        MSG_GRAB => {
+            link.wanted = [TYPE_TEXT, TYPE_PNG]
+                .into_iter()
+                .filter(|kind| data.chunks_exact(4).any(|offered| u32_at(offered, 0) == *kind))
+                .collect();
+            link.fetched = Some(Clip::default());
+            match link.asked {
+                // Its reply, when it comes, is for an offer gone: the new one follows it.
+                Some((kind, _, since)) if since.elapsed() < REPLY_WAIT => {
+                    link.asked = Some((kind, false, since));
+                }
+                _ => {
+                    link.asked = None;
+                    request_next(link);
+                }
+            }
+        }
+        MSG_CLIPBOARD if data.len() >= 4 => {
+            let Some((asked, current, _)) = link.asked.take() else {
+                return;
+            };
+            if current && u32_at(data, 0) == asked && data.len() > 4 {
+                if let Some(clip) = link.fetched.as_mut() {
+                    let bytes = data[4..].to_vec();
+                    match asked {
+                        TYPE_TEXT => clip.text = Some(bytes),
+                        _ => clip.png = Some(bytes),
+                    }
+                }
+            }
+            request_next(link);
+        }
+        MSG_REQUEST if data.len() >= 4 => {
+            let kind = u32_at(data, 0);
+            let mut reply = kind.to_le_bytes().to_vec();
+            if let Some(bytes) = link.host.get(kind) {
+                reply.extend_from_slice(bytes);
+            }
+            send(link, MSG_CLIPBOARD, reply);
+        }
+        _ => {}
+    }
+}
+
+/// Asks for the next type of the guest's offer, or, when all are in, gives them to SDL.
+fn request_next(link: &mut Link) {
+    if let Some(kind) = link.wanted.pop_front() {
+        link.asked = Some((kind, true, Instant::now()));
+        send(link, MSG_REQUEST, words(&[kind]));
+        return;
+    }
+    let Some(clip) = link.fetched.take().filter(|clip| !clip.is_empty()) else {
+        return;
+    };
+    link.shared = Some(clip.digest());
+    link.guest = clip;
+    let mut mimes: Vec<*const c_char> = Vec::new();
+    if link.guest.text.is_some() {
+        mimes.extend(TEXT_MIMES.iter().map(|mime| mime.as_ptr()));
+    }
+    if link.guest.png.is_some() {
+        mimes.push(PNG_MIME.as_ptr());
+    }
+    // SAFETY: SDL's video runs on this thread; SDL copies the names.
+    let set = unsafe {
+        SDL_SetClipboardData(
+            Some(guest_data),
+            None,
+            std::ptr::null_mut(),
+            mimes.as_ptr(),
+            mimes.len(),
+        )
+    };
+    if !set {
+        log::warn!(
+            target: "reims_vgpu_window",
+            "vmlab clipboard: the guest's was not taken: {}",
+            crate::sdl::sdl_error()
+        );
+    }
+}
+
+/// SDL asks for the guest's clipboard under `mime`: the bytes last fetched, which stay until the
+/// next fetch replaces them (on this thread, as this call is).
+unsafe extern "C" fn guest_data(
+    _userdata: *mut c_void,
+    mime: *const c_char,
+    size: *mut usize,
+) -> *const c_void {
+    let mut found: *const c_void = std::ptr::null();
+    let mut length = 0;
+    if !mime.is_null() {
+        // SAFETY: SDL's string.
+        let mime = unsafe { CStr::from_ptr(mime) };
+        LINK.with(|link| {
+            let Ok(link) = link.try_borrow() else {
+                return;
+            };
+            let Some(link) = link.as_ref() else {
+                return;
+            };
+            let bytes = if mime == PNG_MIME {
+                link.guest.png.as_ref()
+            } else {
+                link.guest.text.as_ref()
+            };
+            if let Some(bytes) = bytes {
+                found = bytes.as_ptr().cast();
+                length = bytes.len();
+            }
+        });
+    }
+    if !size.is_null() {
+        // SAFETY: SDL's place for the size.
+        unsafe { *size = length };
+    }
+    found
+}
+
+/// The host's clipboard may have changed: read it, and offer it where it is not the one shared.
+fn host_changed(link: &mut Link) {
+    if !link.agent {
+        return;
+    }
+    let clip = read_host();
+    let digest = clip.digest();
+    if link.shared == Some(digest) {
+        return;
+    }
+    link.shared = Some(digest);
+    // The guest's offer being fetched is older than this.
+    link.wanted.clear();
+    link.fetched = None;
+    if let Some((kind, _, since)) = link.asked {
+        link.asked = Some((kind, false, since));
+    }
+    let types = clip.types();
+    link.host = clip;
+    if types.is_empty() {
+        send(link, MSG_RELEASE, Vec::new());
+    } else {
+        send(link, MSG_GRAB, words(&types));
+    }
+}
