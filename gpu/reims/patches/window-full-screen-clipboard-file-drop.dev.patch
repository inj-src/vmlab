+/// Queues a message for the writer thread.
+fn send(link: &Link, kind: u32, data: Vec<u8>) {
+    let _ = link.out.send((kind, data));
+}
+
+/// `values` as little-endian bytes.
+fn words(values: &[u32]) -> Vec<u8> {
+    values.iter().flat_map(|value| value.to_le_bytes()).collect()
+}
+
+/// The little-endian u32 at `offset` of `bytes`, which has it.
+fn u32_at(bytes: &[u8], offset: usize) -> u32 {
+    u32::from_le_bytes([
+        bytes[offset],
+        bytes[offset + 1],
+        bytes[offset + 2],
+        bytes[offset + 3],
+    ])
+}
