+/// vmlab: whether the F of a Ctrl+Alt+F is held, whose presses and release the guest never sees.
+static FULL_SCREEN_KEY_HELD: std::sync::atomic::AtomicBool =
+    std::sync::atomic::AtomicBool::new(false);
+
+/// vmlab: Ctrl+Alt+F puts the window on the whole screen and takes it back, as QEMU's own window
+/// does. Whether `key` was that chord's F (its press, a repeat of it or its release), which is
+/// then not the guest's: the guest sees Ctrl and Alt go down and up with nothing between.
+fn full_screen_key(shell: &Shell, key: &SDL_KeyboardEvent) -> bool {
+    use std::sync::atomic::Ordering::Relaxed;
+    if key.scancode != SDL_SCANCODE_F {
+        return false;
+    }
+    if !key.down {
+        return FULL_SCREEN_KEY_HELD.swap(false, Relaxed);
+    }
+    if key.repeat {
+        return FULL_SCREEN_KEY_HELD.load(Relaxed);
+    }
+    let chord = (key.r#mod & SDL_KMOD_CTRL).0 != 0
+        && (key.r#mod & SDL_KMOD_ALT).0 != 0
+        && (key.r#mod & (SDL_KMOD_SHIFT | SDL_KMOD_GUI)).0 == 0;
+    if chord {
+        FULL_SCREEN_KEY_HELD.store(true, Relaxed);
+        // SAFETY: the window is SDL's, on this thread.
+        unsafe {
+            let full = (SDL_GetWindowFlags(shell.sdl) & SDL_WINDOW_FULLSCREEN).0 != 0;
+            if !SDL_SetWindowFullscreen(shell.sdl, !full) {
+                refused_full_screen(shell);
+            }
+        }
+    }
+    chord
+}
