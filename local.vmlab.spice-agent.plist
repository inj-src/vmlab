<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.vmlab.spice-agent</string>
  <key>ProgramArguments</key><array><string>/usr/local/libexec/vmlab-spice-agent</string></array>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/vmlab-spice-agent.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/vmlab-spice-agent.log</string>
</dict></plist>
