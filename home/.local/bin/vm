#!/usr/bin/env bash
# vm: drive the vmlab Windows/macOS test VMs. Run `vm help`.
# Both run on a virtual GPU, outside libvirt, each through its own launcher (which has more
# switches): win = gpu/win3d/win-venus.sh, mac = gpu/reims/mac26.sh. SSH is a forwarded port on
# 127.0.0.1 (vm ip, vm port).
set -euo pipefail

LAB=/vmlab
STATE=${XDG_CACHE_HOME:-$HOME/.cache}/vmlab
KEY=$HOME/.ssh/vmlab_ed25519
mkdir -p "$STATE"

# name -> launcher, its user unit, the SSH port on 127.0.0.1, guest user
declare -A RUN=([win]=$LAB/tools/vmlab/gpu/win3d/win-venus.sh [mac]=$LAB/tools/vmlab/gpu/reims/mac26.sh)
declare -A UNIT=([win]=vmlab-win-venus [mac]=vmlab-mac26d)
declare -A PORT=([win]=2222 [mac]=2227)
declare -A GUSER=([win]=dev [mac]=dev)
WIN_GPU=${VM_WIN_GPU:-nvidia}     # the host GPU Windows draws on (intel|nvidia)

die(){ echo "vm: $*" >&2; exit 1; }
need(){ [[ -n ${RUN[$1]:-} ]] || die "unknown VM '$1' (use: ${!RUN[*]})"; }
state_of(){ systemctl --user is-active --quiet "${UNIT[$1]}" && echo running || echo shutoff; }
running_vms(){ for n in "${!RUN[@]}"; do [[ $(state_of "$n") == running ]] && echo "$n"; done; true; }
has_window(){ systemctl --user show "${UNIT[$1]}" -p Environment | grep -q -E 'VMLAB_WINDOW=|REIMS_VGPU_WINDOW_MAXIMIZED='; }

# Lab-only power: the performance profile while a VM runs, and only on the full-power barrel
# charger (ACAD). The USB-C charger cannot keep up with it. vm stop puts the old profile back.
power_up(){
  command -v powerprofilesctl >/dev/null || return 0
  [[ $(cat /sys/class/power_supply/ACAD/online 2>/dev/null) == 1 ]] || return 0
  local cur; cur=$(powerprofilesctl get 2>/dev/null) || return 0
  [[ $cur == performance ]] && return 0
  [[ -f $STATE/power.prev ]] || echo "$cur" > "$STATE/power.prev"
  powerprofilesctl set performance 2>/dev/null || true
}
power_restore(){
  [[ -f $STATE/power.prev && -z $(running_vms) ]] || return 0
  # Keep power.prev if the switch fails, so a later vm stop can still put the profile back
  powerprofilesctl set "$(cat "$STATE/power.prev")" 2>/dev/null && rm -f "$STATE/power.prev"
  return 0
}

ssh_opts(){ echo -i "$KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$STATE/known_hosts" -o ConnectTimeout=5 -o BatchMode=yes -o LogLevel=ERROR -p "${PORT[$1]}"; }
guest(){ local n=$1; shift; ssh $(ssh_opts "$n") "${GUSER[$n]}@127.0.0.1" "$@"; }

wait_ssh(){
  local n=$1 deadline=$((SECONDS + ${2:-600}))
  while (( SECONDS < deadline )); do
    [[ $(state_of "$n") == running ]] || return 1
    guest "$n" exit 2>/dev/null && return 0
    sleep 5
  done
  return 1
}

cmd_status(){
  for n in "${!RUN[@]}"; do
    local s addr=- owner=""
    s=$(state_of "$n")
    [[ $s == running ]] && addr=127.0.0.1:${PORT[$n]}
    [[ $s == running && -f $STATE/$n.owner ]] && owner=$(cat "$STATE/$n.owner")
    printf '%-4s %-8s %-15s %s\n' "$n" "$s" "$addr" "${owner:+started by $owner}"
  done
}

cmd_start(){
  local n=$1 window=${2:-}; need "$n"
  [[ -z $window || $window == --window ]] || die "usage: vm start <name> [--window]"
  if [[ $(state_of "$n") != running ]]; then
    local other; other=$(running_vms | grep -vx "$n" || true)
    [[ -z $other ]] || die "'$other' is running (one VM at a time). Leave it alone and ask the user, or the user can run: vm stop $other"
    power_up
    case $n in
      win) "${RUN[win]}" start "$WIN_GPU" $window >/dev/null ;;
      mac) "${RUN[mac]}" start $window >/dev/null ;;
    esac || { power_restore; die "$n did not start (${RUN[$n]} status)"; }
    echo "${VM_OWNER:-$USER} $(date -Is)" > "$STATE/$n.owner"
  fi
  wait_ssh "$n" 600 || die "$n booted but SSH did not answer within 10 min (try: vm view $n)"
  # macOS keeps the clock of its last run until it reaches a time server
  [[ $n == mac ]] && { guest mac "sudo -n date -u $(date -u +%m%d%H%M%Y.%S)" >/dev/null 2>&1 || true; }
  echo "$n running at 127.0.0.1 port ${PORT[$n]}"
}

cmd_stop(){
  local n=$1; need "$n"
  [[ $(state_of "$n") == running ]] || { power_restore; echo "$n already stopped"; return; }
  "${RUN[$n]}" stop >/dev/null
  rm -f "$STATE/$n.owner"
  power_restore
  echo "$n stopped"
}

cmd_reset(){
  local n=$1; need "$n"
  [[ $(state_of "$n") != running ]] || die "stop $n first (vm stop $n)"
  "${RUN[$n]}" reset >/dev/null
  echo "$n reset to its clean state"
}

cmd_commit(){
  # Make the stopped VM's disk as it is now the clean state that reset returns to.
  local n=$1; need "$n"
  [[ $(state_of "$n") != running ]] || die "stop $n first"
  "${RUN[$n]}" commit >/dev/null
  echo "$n: its disk as it is now is the clean state"
}

cmd_ssh(){ local n=$1; shift; need "$n"; [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"; exec ssh $(ssh_opts "$n") -t "${GUSER[$n]}@127.0.0.1" "$@"; }
cmd_ip(){ need "$1"; [[ $(state_of "$1") == running ]] || die "$1 is not running"; echo 127.0.0.1; }
cmd_port(){ need "$1"; echo "${PORT[$1]}"; }

cmd_view(){
  local n=$1; need "$n"
  if [[ $(state_of "$n") != running ]]; then cmd_start "$n" --window; return; fi
  if has_window "$n"; then echo "$n is running in a window on the desktop"; return; fi
  case $n in
    win) setsid "${RUN[win]}" view >/dev/null 2>&1 < /dev/null & echo "viewer opened for win (it runs without its window: stop it and vm view win for the window)" ;;
    mac) die "mac runs without a window: vm stop mac, then vm view mac" ;;
  esac
}

cmd_tunnel(){
  local n=$1 port=$2 lport=${3:-$2}; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running"
  ssh $(ssh_opts "$n") -f -N -o ExitOnForwardFailure=yes -L "127.0.0.1:$lport:127.0.0.1:$port" "${GUSER[$n]}@127.0.0.1"
  echo "localhost:$lport -> $n:127.0.0.1:$port (close with: vm untunnel $lport)"
}

# Anchored to ^ssh so it never matches the shell that runs it.
cmd_untunnel(){ pkill -f "^ssh .*-L 127\.0\.0\.1:$1:" && echo "closed localhost:$1" || echo "no tunnel on localhost:$1"; }

# vm forward <name> <port>...: this machine's 127.0.0.1:<port> on the guest's own localhost:<port>
# (an SSH remote forward), for a guest program that expects a service of this machine on
# localhost. GUEST:HOST gives the guest another port number. Closed by vm unforward, or with the VM.
cmd_forward(){
  local n=$1 p args=(); shift; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running"
  for p in "$@"; do
    [[ $p =~ ^([0-9]+)(:([0-9]+))?$ ]] || die "usage: vm forward <name> <port|guestport:hostport>..."
    # (asked first: Windows' sshd lets a second forward have a port that is taken, and says nothing)
    pgrep -f "^ssh .*-p ${PORT[$n]} .*-R ${BASH_REMATCH[1]}:127\\.0\\.0\\.1:" > /dev/null &&
      die "$n's port ${BASH_REMATCH[1]} is forwarded already (vm unforward $n closes all of $n's)"
    args+=(-R "${BASH_REMATCH[1]}:127.0.0.1:${BASH_REMATCH[3]:-${BASH_REMATCH[1]}}")
  done
  ssh $(ssh_opts "$n") -f -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 "${args[@]}" "${GUSER[$n]}@127.0.0.1" ||
    die "no forward: is a port taken in $n already (vm unforward $n)?"
  echo "$n: localhost ports ${*} reach this machine (close with: vm unforward $n)"
}
cmd_unforward(){ need "$1"; pkill -f "^ssh .*-p ${PORT[$1]} .*-R [0-9]+:127\.0\.0\.1:" && echo "closed $1's forwards" || echo "$1 has no forwards"; }

# vm gui <name> <verb>...: the VM's screen, keyboard and pointer from outside it (gpu/reims/qdrive.py)
cmd_gui(){
  local n=$1; shift; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"
  case $n in
    win) QDRIVE_VNC=5911 exec python3 -I "$LAB/tools/vmlab/gpu/reims/qdrive.py" "$LAB/run/win-venus/qmp.sock" "$@" ;;
    mac) exec "${RUN[mac]}" gui "$@" ;;
  esac
}

# vm push <name> <dir> [dest]: the git work tree <dir> is in, as it is now (uncommitted changes
# and untracked files too, ignored files not), mirrored to a checkout in the guest. It goes as
# a git bundle over SSH, after the first time only what changed. In the guest, files that left
# the tree are removed and ignored ones (build output) are kept, so builds stay incremental.
# The snapshot is a commit of its own that no branch holds: the repository's index, branch and
# work tree are not touched; refs/vmlab/push/<name> keeps the last one, so the next push can
# send the difference.
cmd_push(){
  local n=$1 src=$2 dest=${3:-} top; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"
  top=$(git -C "$src" rev-parse --show-toplevel 2>/dev/null) || die "$src is not in a git work tree"
  local home; case $n in win) home=C:/Users/${GUSER[$n]} ;; mac) home=/Users/${GUSER[$n]} ;; esac
  # On the build cache disk: the checkout and its build output outlive `vm reset`
  [[ -n $dest ]] || case $n in win) dest=C:/cache/src/$(basename "$top") ;; mac) dest=$home/cache/src/$(basename "$top") ;; esac
  dest=${dest//\\//}
  [[ $dest =~ ^[A-Za-z0-9_./:\ -]+$ ]] || die "the destination may hold letters, digits, spaces and . _ - / : only: $dest"

  local tmp; tmp=$(mktemp -d "$LAB/tmp/vm-push.XXXXXX")
  # The work tree as a tree object, through an index of its own (a copy, so unchanged files
  # are not read again)
  cp "$(git -C "$top" rev-parse --absolute-git-dir)/index" "$tmp/index" 2>/dev/null || true
  local tree commit prev ref=refs/vmlab/push/$n
  GIT_INDEX_FILE=$tmp/index git -C "$top" add -A
  tree=$(GIT_INDEX_FILE=$tmp/index git -C "$top" write-tree)
  # The same tree gives the same commit: no parent, fixed name and date
  commit=$(GIT_AUTHOR_NAME=vmlab GIT_AUTHOR_EMAIL=vmlab@localhost GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
    GIT_COMMITTER_NAME=vmlab GIT_COMMITTER_EMAIL=vmlab@localhost GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
    git -C "$top" commit-tree "$tree" -m "vm push") || { rm -rf "$tmp"; die "could not record the work tree"; }
  git -C "$top" update-ref "$ref" "$commit"

  # What the guest's checkout is at; a bundle of the difference where this repository still
  # has that commit, of everything otherwise (first push, or the VM was reset)
  prev=$(guest "$n" "git -C \"$dest\" rev-parse -q --verify refs/vmlab/pushed" 2>/dev/null | tr -d '\r\n' || true)
  local sent="nothing to send"
  if [[ $prev != "$commit" ]]; then
    local -a range=("$ref")
    [[ $prev =~ ^[0-9a-f]{40,64}$ ]] && git -C "$top" cat-file -e "$prev^{commit}" 2>/dev/null && range+=("^$prev")
    git -C "$top" bundle create -q "$tmp/push.bundle" "${range[@]}" || { rm -rf "$tmp"; die "could not pack the work tree"; }
    sent="$(du -h "$tmp/push.bundle" | cut -f1) sent"
    local -a o; read -r -a o <<< "$(ssh_opts "$n")"
    scp -q "${o[@]/#-p/-P}" "$tmp/push.bundle" "${GUSER[$n]}@127.0.0.1:$home/vm-push.bundle" || { rm -rf "$tmp"; die "could not copy the bundle to $n"; }
    # One line that PowerShell 7 and zsh both run. autocrlf off: the guest gets the bytes the
    # host has
    guest "$n" "git init -q \"$dest\" && git -C \"$dest\" config core.autocrlf false && git -C \"$dest\" config core.longpaths true && git -C \"$dest\" fetch -q \"$home/vm-push.bundle\" $ref && git -C \"$dest\" checkout -q -f --detach FETCH_HEAD && git -C \"$dest\" clean -q -fd && git -C \"$dest\" update-ref refs/vmlab/pushed FETCH_HEAD && git -C \"$dest\" rev-parse -q --verify refs/vmlab/pushed" \
      | tr -d '\r\n' | grep -qx "$commit" || { rm -rf "$tmp"; die "$n did not take the bundle (left in the guest: $home/vm-push.bundle)"; }
    guest "$n" "rm \"$home/vm-push.bundle\"; git -C \"$dest\" gc -q --auto" >/dev/null 2>&1 || true
  fi
  rm -rf "$tmp"
  echo "$n: $dest is the work tree of $top ($sent)"
}

# The build caches: each VM's second disk (C:\cache, ~/cache), which reset and commit leave
# alone. The launchers attach them and make a missing one again, empty, from
# /vmlab/images/<name>-cache-empty.qcow2: emptying one is deleting its file.
CACHE=${VMLAB_CACHE:-$HOME/.local/share/vmlab/cache}
cmd_cache(){
  local n
  if [[ ${1:-} == clear ]]; then
    n=${2:-}; need "$n"
    [[ $(state_of "$n") == running ]] && die "$n is running (vm stop $n)"
    [[ -f $LAB/images/$n-cache-empty.qcow2 ]] || die "no empty cache disk to start again from ($LAB/images/$n-cache-empty.qcow2)"
    rm -f "$CACHE/$n.qcow2"; echo "$n: the build cache is empty"
  elif [[ $# == 0 ]]; then
    for n in win mac; do
      if [[ -f $CACHE/$n.qcow2 ]]; then echo "$n  $(du -h "$CACHE/$n.qcow2" | cut -f1) of 25G at most  $CACHE/$n.qcow2"
      else echo "$n  none yet"; fi
    done
  else die "usage: vm cache | vm cache clear <name>"; fi
}

cmd_help(){ cat <<'EOF'
vm status                      which VM is running, where its SSH is, who started it
vm start <win|mac> [--window]  boot (refuses if the other VM is running) and wait for SSH.
                               --window: in a window on the desktop (full screen: its title
                               bar's button or Ctrl+Alt+F; shared clipboard; files dropped on
                               it land on the guest's desktop). Without: no window
vm ssh <name> [command...]     shell or one command in the VM (win: PowerShell, mac: zsh)
vm push <name> <dir> [dest]    mirror the git work tree at <dir>, uncommitted and untracked
                               files too (not ignored ones), to the guest's build cache:
                               C:\cache\src\<repo> on win, ~/cache/src/<repo> on mac, or to
                               <dest>. Later pushes send only the changes and keep the
                               guest's build output
vm cache                       how large each VM's build cache is. C:\cache and ~/cache are a
                               disk of their own that reset and commit leave alone
vm cache clear <name>          empty that VM's build cache (VM must be stopped)
vm tunnel <name> <port> [lp]   forward VM's 127.0.0.1:<port> to localhost:<lp>
vm untunnel <localport>        close a tunnel opened by vm tunnel
vm forward <name> <port>...    the other way: this machine's 127.0.0.1:<port> on the VM's own
                               localhost:<port> (GUEST:HOST for another number in the VM)
vm unforward <name>            close that VM's forwards
vm gui <name> shot FILE.png    the VM's screen as a picture, whatever is on it
vm gui <name> click X Y [right|double] | move X Y | drag X1 Y1 X2 Y2
vm gui <name> type 'text' | key ctrl+s [ret ...] | size
                               the VM's own keyboard and pointer, at pixels of that picture.
                               The guest takes them for a person's (Windows does not mark
                               them as injected). Key names: win (= cmd), alt, ctrl, shift
                               and QEMU's (ret, esc, tab, f4, up, delete, a, 1)
vm view <name>                 start it in its window; if it already runs without one, win
                               opens a plain viewer and mac has to be stopped first
vm ip <name>, vm port <name>   where the VM's SSH is: 127.0.0.1 and a port (win 2222, mac 2227)
Shared folder: /vmlab/share on this machine is C:\share on win and ~/share on mac.
vm stop <name>                 graceful shutdown (forced after 2 min)
vm reset <name>                discard all changes since the clean state (VM must be stopped)
vm commit <name>               make the current state the new clean state (VM must be stopped)
EOF
}

sub=${1:-help}; shift || true
case $sub in
  status|help) "cmd_$sub" ;;
  start) [[ $# -ge 1 ]] || die "usage: vm start <name> [--window]"; cmd_start "$1" "${2:-}" ;;
  stop|reset|commit|ip|port|view) [[ $# -ge 1 ]] || die "usage: vm $sub <name>"; "cmd_$sub" "$1" ;;
  ssh) [[ $# -ge 1 ]] || die "usage: vm ssh <name> [cmd]"; cmd_ssh "$@" ;;
  untunnel) [[ $# -ge 1 ]] || die "usage: vm untunnel <localport>"; cmd_untunnel "$1" ;;
  cache) cmd_cache "$@" ;;
  push) [[ $# -ge 2 && $# -le 3 ]] || die "usage: vm push <name> <dir> [dest]"; cmd_push "$@" ;;
  tunnel) [[ $# -ge 2 ]] || die "usage: vm tunnel <name> <port> [localport]"; cmd_tunnel "$@" ;;
  forward) [[ $# -ge 2 ]] || die "usage: vm forward <name> <port|guestport:hostport>..."; cmd_forward "$@" ;;
  unforward) [[ $# -ge 1 ]] || die "usage: vm unforward <name>"; cmd_unforward "$1" ;;
  gui) [[ $# -ge 2 ]] || die "usage: vm gui <name> shot FILE.png | click X Y | type 'text' | key ctrl+s (vm help)"; cmd_gui "$@" ;;
  *) die "unknown command '$sub' (vm help)" ;;
esac
