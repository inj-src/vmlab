#!/usr/bin/env bash
# vm: drive the vmlab Windows/macOS test VMs. Run `vm help`.
# Both run on a virtual GPU, outside libvirt, each through its own launcher (which has more
# switches): win = gpu/win3d/win-venus.sh, mac = gpu/reims/mac26.sh. SSH is a forwarded port on
# 127.0.0.1 (vm ip, vm port).
set -euo pipefail

LAB=/vmlab
STATE=${XDG_CACHE_HOME:-$HOME/.cache}/vmlab
KEY=$HOME/.ssh/vmlab_ed25519
mkdir -p "$STATE"
# The VMs are user units. A caller with a stripped environment (an MCP server started by Codex)
# has no XDG_RUNTIME_DIR, and systemctl --user then finds no bus and every VM looks shut off.
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}

# name -> launcher, its user unit, the SSH port on 127.0.0.1, guest user
declare -A RUN=([win]=$LAB/tools/vmlab/gpu/win3d/win-venus.sh [mac]=$LAB/tools/vmlab/gpu/reims/mac26.sh)
declare -A UNIT=([win]=vmlab-win-venus [mac]=vmlab-mac26d)
declare -A PORT=([win]=2222 [mac]=2227)
declare -A GUSER=([win]=dev [mac]=dev)
WIN_GPU=${VM_WIN_GPU:-nvidia}     # the host GPU Windows draws on (intel|nvidia)

die(){ echo "vm: $*" >&2; exit 1; }
need(){ [[ -n ${RUN[$1]:-} ]] || die "unknown VM '$1' (use: ${!RUN[*]})"; }
state_of(){ systemctl --user is-active --quiet "${UNIT[$1]}" && echo running || echo shutoff; }
running_vms(){ for n in "${!RUN[@]}"; do [[ $(state_of "$n") == running ]] && echo "$n"; done; true; }
has_window(){ systemctl --user show "${UNIT[$1]}" -p Environment | grep -q -E 'VMLAB_WINDOW=|REIMS_VGPU_WINDOW_MAXIMIZED='; }

# Lab-only power: the performance profile while a VM runs, and only on the full-power barrel
# charger (ACAD). The USB-C charger cannot keep up with it. vm stop puts the old profile back.
power_up(){
  command -v powerprofilesctl >/dev/null || return 0
  [[ $(cat /sys/class/power_supply/ACAD/online 2>/dev/null) == 1 ]] || return 0
  local cur; cur=$(powerprofilesctl get 2>/dev/null) || return 0
  [[ $cur == performance ]] && return 0
  [[ -f $STATE/power.prev ]] || echo "$cur" > "$STATE/power.prev"
  powerprofilesctl set performance 2>/dev/null || true
}
power_restore(){
  [[ -f $STATE/power.prev && -z $(running_vms) ]] || return 0
  # Keep power.prev if the switch fails, so a later vm stop can still put the profile back
  powerprofilesctl set "$(cat "$STATE/power.prev")" 2>/dev/null && rm -f "$STATE/power.prev"
  return 0
}

# One SSH connection per VM, shared by the calls of the next two minutes (ControlMaster): a call
# then starts in 0.3 s in place of 0.5 s. The shared connection ends with the VM.
# vm tunnel and vm forward keep their own connection: on the shared one a forward would end two
# minutes after the last call, and vm untunnel could not find it. (ssh takes the first value it
# is given for an option, so their -o ControlPath=none stands before ssh_opts.)
MUX="-o ControlMaster=auto -o ControlPath=$STATE/ssh-%p -o ControlPersist=120"
ssh_opts(){ echo -i "$KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$STATE/known_hosts" -o ConnectTimeout=5 -o BatchMode=yes -o LogLevel=ERROR $MUX -p "${PORT[$1]}"; }
guest(){ local n=$1; shift; ssh $(ssh_opts "$n") "${GUSER[$n]}@127.0.0.1" "$@"; }

wait_ssh(){
  local n=$1 deadline=$((SECONDS + ${2:-600}))
  while (( SECONDS < deadline )); do
    [[ $(state_of "$n") == running ]] || return 1
    guest "$n" exit 2>/dev/null && return 0
    sleep 5
  done
  return 1
}

cmd_status(){
  for n in "${!RUN[@]}"; do
    local s addr=- owner=""
    s=$(state_of "$n")
    [[ $s == running ]] && addr=127.0.0.1:${PORT[$n]}
    [[ $s == running && -f $STATE/$n.owner ]] && owner=$(cat "$STATE/$n.owner")
    local on; on=$(st_cur "$n"); st_chg "$n" && on+=", changed since"
    printf '%-4s %-8s %-15s %s\n' "$n" "$s" "$addr" "${owner:+started by $owner  }state: $on"
  done
}

cmd_start(){
  local n=$1 window="" state="" a; shift; need "$n"
  for a in "$@"; do case $a in
    --window) window=--window ;;
    ''|-*) [[ -z $a ]] || die "usage: vm start <name> [state] [--window]" ;;
    *) [[ -z $state ]] || die "usage: vm start <name> [state] [--window]"; state=$a ;;
  esac; done
  # A state: its disk becomes the VM's. The same state again goes on where the VM stopped:
  # start never drops what a run wrote, reset does.
  local other=""
  [[ $(state_of "$n") == running ]] || other=$(running_vms | grep -vx "$n" || true)
  [[ -z $other ]] || die "'$other' is running (one VM at a time). Leave it alone and ask the user, or the user can run: vm stop $other"
  if [[ -n $state ]]; then
    local cur; cur=$(st_cur "$n")
    if [[ $(state_of "$n") == running ]]; then
      [[ $cur == "$state" ]] || die "$n is running on '$cur' (vm stop $n first)"
    elif [[ $cur == "$state" ]]; then
      if st_chg "$n" && [[ $state != clean ]]; then
        echo "$n goes on from where it stopped: '$state' with changes not saved (for the state as saved: vm reset $n --discard, then start again)"
      fi
    elif [[ $state == clean ]]; then "${RUN[$n]}" reset > /dev/null || exit 1
    else "${RUN[$n]}" state load "$state" > /dev/null || exit 1
    fi
  fi
  # Asked for a window while it runs already: show it, the way vm view does
  if [[ -n $window && $(state_of "$n") == running ]]; then cmd_view "$n"; return; fi
  if [[ $(state_of "$n") != running ]]; then
    power_up
    case $n in
      win) "${RUN[win]}" start "$WIN_GPU" $window >/dev/null ;;
      mac) "${RUN[mac]}" start $window >/dev/null ;;
    esac || { power_restore; die "$n did not start (${RUN[$n]} status)"; }
    echo "${VM_OWNER:-$USER} $(date -Is)" > "$STATE/$n.owner"
  fi
  wait_ssh "$n" 600 || die "$n booted but SSH did not answer within 10 min (try: vm view $n)"
  # macOS keeps the clock of its last run until it reaches a time server
  [[ $n == mac ]] && { guest mac "sudo -n date -u $(date -u +%m%d%H%M%Y.%S)" >/dev/null 2>&1 || true; }
  echo "$n running at 127.0.0.1 port ${PORT[$n]}"
  # For an agent (no terminal): where the GUI tools are, at the moment it has a VM to drive.
  [[ -t 1 ]] || echo "GUI work on $n: the vmlab MCP tools (mcp__vmlab__*), not vm gui." >&2
}

cmd_stop(){
  local n=$1; need "$n"
  [[ $(state_of "$n") == running ]] || { power_restore; echo "$n already stopped"; return; }
  "${RUN[$n]}" stop >/dev/null
  rm -f "$STATE/$n.owner"
  power_restore
  echo "$n stopped"
}

cmd_reset(){
  local n=$1 flag=${2:-}; need "$n"
  [[ -z $flag || $flag == --discard ]] || die "usage: vm reset <name> [--discard]"
  [[ $(state_of "$n") != running ]] || die "stop $n first (vm stop $n)"
  "${RUN[$n]}" reset $flag >/dev/null || exit 1
  echo "$n reset to its clean state"
}

cmd_commit(){
  # Make the stopped VM's disk as it is now the clean state that reset returns to.
  local n=$1 flag=${2:-}; need "$n"
  [[ $flag =~ ^(|--keep-states|--drop-states)$ ]] || die "usage: vm commit <name> [--keep-states|--drop-states]"
  [[ $(state_of "$n") != running ]] || die "stop $n first"
  "${RUN[$n]}" commit $flag >/dev/null || exit 1
  echo "$n: its disk as it is now is the clean state"
}

# vm ssh <name> [command...]: plain SSH with stdin passed on, as `ssh win` / `ssh mac` (the
# guests put every session on the desktop: win/desktop-ssh.ps1, mac/desktop-ssh.sh). Not in vm
# help; the lab's own scripts use it, as they run before ~/.ssh/config has the lab's hosts.
cmd_ssh(){ local n=$1; shift; need "$n"; [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"; exec ssh $(ssh_opts "$n") -t "${GUSER[$n]}@127.0.0.1" "$@"; }

# vm execute <name> [--timeout SEC] [command...]: one command, run as vm run runs a script (on
# the desktop, same output and exit code). Without a command, in a terminal: a shell for a person.
cmd_execute(){
  local n=$1; shift; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"
  local t=()
  if [[ ${1:-} == --timeout ]]; then t=(--timeout "${2:-}"); shift 2 || die "vm execute: --timeout takes seconds"; fi
  if (( $# == 0 )); then
    [[ -t 0 ]] || die "vm execute: give a command (vm execute $n \"<command>\"), or a script to vm run"
    exec ssh $(ssh_opts "$n") -t "${GUSER[$n]}@127.0.0.1"
  fi
  local f rc=0; f=$(mktemp "$STATE/exec.XXXXXX")
  printf '%s\n' "$*" > "$f"
  cmd_run "$n" "${t[@]}" "$f" || rc=$?
  rm -f "$f"
  return $rc
}
cmd_ip(){ need "$1"; [[ $(state_of "$1") == running ]] || die "$1 is not running"; echo 127.0.0.1; }

# vm run <name> [--timeout SEC] [FILE]: run a script in the VM. The script is stdin (a quoted
# heredoc) or FILE and goes over as a file, so no shell on the way reads its quotes or its $.
# win: PowerShell 7 on the visible desktop, as dev with admin rights (win/vm-run.ps1).
# mac: zsh, a login shell in the desktop (Aqua) session, where SSH alone is in the background one.
# Output and exit code are the script's; 124 means it ran out of time.
cmd_run(){
  local n=$1; shift; need "$n"
  local timeout=3600 file=-
  while (( $# )); do
    case $1 in
      --timeout) [[ ${2:-} =~ ^[0-9]+$ ]] || die "vm run: --timeout takes seconds"; timeout=$2; shift 2 ;;
      -) shift ;;
      -*) die "vm run: unknown option '$1' (vm help)" ;;
      *) file=$1; shift ;;
    esac
  done
  [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"
  [[ $file != - || ! -t 0 ]] || die "vm run: give the script on stdin (vm run $n <<'EOF' ... EOF) or as a file"
  [[ $file == - || -r $file ]] || die "vm run: cannot read $file"
  local tmp id rc=0
  tmp=$(mktemp "$STATE/run.XXXXXX"); id=$(basename "$tmp"); id=${id#run.}
  cat -- "$file" > "$tmp"
  [[ -s $tmp ]] || { rm -f "$tmp"; die "vm run: the script is empty"; }
  local scp_opts=(-q -i "$KEY" -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$STATE/known_hosts" -o ConnectTimeout=5 -o BatchMode=yes -o LogLevel=ERROR $MUX -P "${PORT[$n]}")
  case $n in
    win)
      # the guest's half goes along with every run: win/vm-run.ps1 (nothing is installed there)
      local s=".vmrun-$id.ps1" h=".vmrun-$id.helper.ps1" d; d=$(mktemp -d "$STATE/run.d.XXXXXX")
      cp "$tmp" "$d/$s"; cp "$LAB/tools/vmlab/win/vm-run.ps1" "$d/$h"
      scp "${scp_opts[@]}" "$d/$s" "$d/$h" "${GUSER[$n]}@127.0.0.1:." || { rm -rf "$d" "$tmp"; die "vm run: could not send the script"; }
      rm -rf "$d"
      guest win 'pwsh -NoProfile -File $HOME\'"$h"' -Script $HOME\'"$s"' -TimeoutSec '"$timeout"'; exit $LASTEXITCODE' < /dev/null | sed -u 's/\r$//' || rc=${PIPESTATUS[0]} ;;
    mac)
      local s=".vmrun-$id.zsh"
      scp "${scp_opts[@]}" "$tmp" "${GUSER[$n]}@127.0.0.1:$s" || { rm -f "$tmp"; die "vm run: could not send the script"; }
      timeout "$timeout" ssh $(ssh_opts mac) "${GUSER[$n]}@127.0.0.1" "if sudo -n true 2>/dev/null; then sudo -n launchctl asuser \$(id -u) sudo -n -u \$(id -un) -H zsh -l $s; else zsh -l $s; fi; c=\$?; rm -f $s; exit \$c" < /dev/null || rc=$?
      # out of time: the script and what it started are still running there
      (( rc != 124 )) || echo "vm run: stopped after $timeout s" >&2
      (( rc != 124 )) || guest mac "k(){ local c; for c in \$(pgrep -P \$1); do k \$c; done; kill \$1 2>/dev/null; }; for p in \$(pgrep -f '[z]sh -l $s'); do k \$p; done; rm -f $s" < /dev/null || true ;;
  esac
  rm -f "$tmp"
  return $rc
}
cmd_port(){ need "$1"; echo "${PORT[$1]}"; }

cmd_view(){
  local n=$1; need "$n"
  if [[ $(state_of "$n") != running ]]; then cmd_start "$n" --window; return; fi
  if has_window "$n"; then echo "$n is running in a window on the desktop"; return; fi
  case $n in
    win) setsid "${RUN[win]}" view >/dev/null 2>&1 < /dev/null &
      echo "win was started without a window, so this is a plain viewer of its screen. For its real window: vm stop win, then vm view win" ;;
    mac) die "mac runs without a window: vm stop mac, then vm view mac" ;;
  esac
}

cmd_tunnel(){
  local n=$1 port=$2 lport=${3:-$2}; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running"
  ssh -o ControlMaster=no -o ControlPath=none $(ssh_opts "$n") -f -N -o ExitOnForwardFailure=yes -L "127.0.0.1:$lport:127.0.0.1:$port" "${GUSER[$n]}@127.0.0.1"
  echo "localhost:$lport -> $n:127.0.0.1:$port (close with: vm untunnel $lport)"
}

# Anchored to ^ssh so it never matches the shell that runs it.
cmd_untunnel(){ pkill -f "^ssh .*-L 127\.0\.0\.1:$1:" && echo "closed localhost:$1" || echo "no tunnel on localhost:$1"; }

# vm forward <name> <port>...: this machine's 127.0.0.1:<port> on the guest's own localhost:<port>
# (an SSH remote forward), for a guest program that expects a service of this machine on
# localhost. GUEST:HOST gives the guest another port number. Closed by vm unforward, or with the VM.
cmd_forward(){
  local n=$1 p args=(); shift; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running"
  for p in "$@"; do
    [[ $p =~ ^([0-9]+)(:([0-9]+))?$ ]] || die "usage: vm forward <name> <port|guestport:hostport>..."
    # (asked first: Windows' sshd lets a second forward have a port that is taken, and says nothing)
    pgrep -f "^ssh .*-p ${PORT[$n]} .*-R ${BASH_REMATCH[1]}:127\\.0\\.0\\.1:" > /dev/null &&
      die "$n's port ${BASH_REMATCH[1]} is forwarded already (vm unforward $n closes all of $n's)"
    args+=(-R "${BASH_REMATCH[1]}:127.0.0.1:${BASH_REMATCH[3]:-${BASH_REMATCH[1]}}")
  done
  ssh -o ControlMaster=no -o ControlPath=none $(ssh_opts "$n") -f -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 "${args[@]}" "${GUSER[$n]}@127.0.0.1" ||
    die "no forward: is a port taken in $n already (vm unforward $n)?"
  echo "$n: localhost ports ${*} reach this machine (close with: vm unforward $n)"
}
cmd_unforward(){ need "$1"; pkill -f "^ssh .*-p ${PORT[$1]} .*-R [0-9]+:127\.0\.0\.1:" && echo "closed $1's forwards" || echo "$1 has no forwards"; }

# vm gui <name> <verb>...: the VM's screen, keyboard and pointer from outside it (gpu/reims/qdrive.py)
cmd_gui(){
  local n=$1; shift; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"
  case $n in
    win) QDRIVE_VNC=5911 exec python3 -I "$LAB/tools/vmlab/gpu/reims/qdrive.py" "$LAB/run/win-venus/qmp.sock" "$@" ;;
    mac) exec "${RUN[mac]}" gui "$@" ;;
  esac
}

# vm push <name> <dir> [dest]: the git work tree <dir> is in, as it is now (uncommitted changes
# and untracked files too, ignored files not), mirrored to a checkout in the guest. It goes as
# a git bundle over SSH, after the first time only what changed. In the guest, files that left
# the tree are removed and ignored ones (build output) are kept, so builds stay incremental.
# The snapshot is a commit of its own that no branch holds: the repository's index, branch and
# work tree are not touched; refs/vmlab/push/<name> keeps the last one, so the next push can
# send the difference.
cmd_push(){
  local n=$1 src=$2 dest=${3:-} top; need "$n"
  [[ $(state_of "$n") == running ]] || die "$n is not running (vm start $n)"
  top=$(git -C "$src" rev-parse --show-toplevel 2>/dev/null) || die "$src is not in a git work tree"
  local home; case $n in win) home=C:/Users/${GUSER[$n]} ;; mac) home=/Users/${GUSER[$n]} ;; esac
  # On the build cache disk: the checkout and its build output outlive `vm reset`
  [[ -n $dest ]] || case $n in win) dest=C:/cache/src/$(basename "$top") ;; mac) dest=$home/cache/src/$(basename "$top") ;; esac
  dest=${dest//\\//}
  [[ $dest =~ ^[A-Za-z0-9_./:\ -]+$ ]] || die "the destination may hold letters, digits, spaces and . _ - / : only: $dest"

  local tmp; tmp=$(mktemp -d "$LAB/tmp/vm-push.XXXXXX")
  # The work tree as a tree object, through an index of its own (a copy, so unchanged files
  # are not read again)
  cp "$(git -C "$top" rev-parse --absolute-git-dir)/index" "$tmp/index" 2>/dev/null || true
  local tree commit prev ref=refs/vmlab/push/$n
  GIT_INDEX_FILE=$tmp/index git -C "$top" add -A
  tree=$(GIT_INDEX_FILE=$tmp/index git -C "$top" write-tree)
  # The same tree gives the same commit: no parent, fixed name and date
  commit=$(GIT_AUTHOR_NAME=vmlab GIT_AUTHOR_EMAIL=vmlab@localhost GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
    GIT_COMMITTER_NAME=vmlab GIT_COMMITTER_EMAIL=vmlab@localhost GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
    git -C "$top" commit-tree "$tree" -m "vm push") || { rm -rf "$tmp"; die "could not record the work tree"; }
  git -C "$top" update-ref "$ref" "$commit"

  # What the guest's checkout is at; a bundle of the difference where this repository still
  # has that commit, of everything otherwise (first push, or the VM was reset)
  prev=$(guest "$n" "git -C \"$dest\" rev-parse -q --verify refs/vmlab/pushed" 2>/dev/null | tr -d '\r\n' || true)
  local sent="nothing to send"
  if [[ $prev != "$commit" ]]; then
    local -a range=("$ref")
    [[ $prev =~ ^[0-9a-f]{40,64}$ ]] && git -C "$top" cat-file -e "$prev^{commit}" 2>/dev/null && range+=("^$prev")
    git -C "$top" bundle create -q "$tmp/push.bundle" "${range[@]}" || { rm -rf "$tmp"; die "could not pack the work tree"; }
    sent="$(du -h "$tmp/push.bundle" | cut -f1) sent"
    local -a o; read -r -a o <<< "$(ssh_opts "$n")"
    scp -q "${o[@]/#-p/-P}" "$tmp/push.bundle" "${GUSER[$n]}@127.0.0.1:$home/vm-push.bundle" || { rm -rf "$tmp"; die "could not copy the bundle to $n"; }
    # One line that PowerShell 7 and zsh both run. autocrlf off: the guest gets the bytes the
    # host has
    guest "$n" "git init -q \"$dest\" && git -C \"$dest\" config core.autocrlf false && git -C \"$dest\" config core.longpaths true && git -C \"$dest\" fetch -q \"$home/vm-push.bundle\" $ref && git -C \"$dest\" checkout -q -f --detach FETCH_HEAD && git -C \"$dest\" clean -q -fd && git -C \"$dest\" update-ref refs/vmlab/pushed FETCH_HEAD && git -C \"$dest\" rev-parse -q --verify refs/vmlab/pushed" \
      | tr -d '\r\n' | grep -qx "$commit" || { rm -rf "$tmp"; die "$n did not take the bundle (left in the guest: $home/vm-push.bundle)"; }
    guest "$n" "rm \"$home/vm-push.bundle\"; git -C \"$dest\" gc -q --auto" >/dev/null 2>&1 || true
  fi
  rm -rf "$tmp"
  echo "$n: $dest is the work tree of $top ($sent)"
}

# The build caches: each VM's second disk (C:\cache, ~/cache), which reset and commit leave
# alone. The launchers attach them and make a missing one again, empty, from
# /vmlab/images/<name>-cache-empty.qcow2: emptying one is deleting its file.
CACHE=${VMLAB_CACHE:-$HOME/.local/share/vmlab/cache}
cmd_cache(){
  local n
  if [[ ${1:-} == clear ]]; then
    n=${2:-}; need "$n"
    [[ $(state_of "$n") == running ]] && die "$n is running (vm stop $n)"
    [[ -f $LAB/images/$n-cache-empty.qcow2 ]] || die "no empty cache disk to start again from ($LAB/images/$n-cache-empty.qcow2)"
    rm -f "$CACHE/$n.qcow2"; echo "$n: the build cache is empty"
  elif [[ $# == 0 ]]; then
    for n in win mac; do
      if [[ -f $CACHE/$n.qcow2 ]]; then echo "$n  $(du -h "$CACHE/$n.qcow2" | cut -f1) of 25G at most  $CACHE/$n.qcow2"
      else echo "$n  none yet"; fi
    done
  else die "usage: vm cache | vm cache clear <name>"; fi
}

# ---- Named states: a VM's disk kept under a name (the launchers do the keeping: gpu/states.sh).
# The marks and the notes are files in $STATES_DIR/<vm>/.
STATES_DIR=$LAB/images/states
st_cur(){ cat "$STATES_DIR/$1/.current" 2>/dev/null || echo clean; }
st_chg(){ [[ -e $STATES_DIR/$1/.changed ]]; }
st_has(){ "${RUN[$1]}" state list | cut -f1 | grep -qx -- "$2"; }
st_size(){ [[ $1 == - ]] && echo - || numfmt --to=iec --format=%.1f "$1"; }
st_when(){ [[ $1 == - ]] && echo - || date -d "@$1" '+%Y-%m-%d %H:%M'; }
ask(){ local a; read -r -p "$1 [y/N] " a < /dev/tty; [[ $a == [yY]* ]]; }
tty_both(){ [[ -t 0 && -t 1 ]]; }

# One line a state, tabs between: vm, state, bytes or -, time saved (epoch) or -, "loaded" where
# the VM's disk is that state, "changed" where it ran since, the note. The clean state is first.
state_rows(){
  local n name bytes when cur
  for n in win mac; do
    cur=$(st_cur "$n")
    printf '%s\tclean\t-\t-\t%s\t%s\t%s\n' "$n" "$([[ $cur == clean ]] && echo loaded || echo -)" \
      "$([[ $cur == clean ]] && st_chg "$n" && echo changed || echo -)" "what vm reset $n returns to"
    while IFS=$'\t' read -r name bytes when; do
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$name" "$bytes" "$when" "$([[ $cur == "$name" ]] && echo loaded || echo -)" \
        "$([[ $cur == "$name" ]] && st_chg "$n" && echo changed || echo -)" "$(head -n1 "$STATES_DIR/$n/$name.note" 2>/dev/null || true)"
    done < <("${RUN[$n]}" state list | sort)
  done
}
# The same as a table, for agents and pipes
state_table(){
  local n name bytes when cur chg note now
  printf '%-4s %-16s %7s  %-16s  %-15s  %s\n' VM STATE SIZE SAVED NOW NOTE
  while IFS=$'\t' read -r n name bytes when cur chg note; do
    now=""; [[ $cur == loaded ]] && now=loaded; [[ $chg == changed ]] && now="loaded, changed"
    [[ $cur == loaded && $(state_of "$n") == running ]] && now=running
    printf '%-4s %-16s %7s  %-16s  %-15s  %s\n' "$n" "$name" "$(st_size "$bytes")" "$(st_when "$when")" "$now" "$note"
  done < <(state_rows)
}
# The list's lines: the vm and the state in front for fzf's {1} {2}, then what is shown. A line
# of "-" in front is not a state: a VM's title, or the empty line before the next one. Every
# state is one line; fzf cuts a long note off at the terminal's edge.
st_day(){
  local d; d=$(date -d "@$1" +%F)
  if [[ $d == $(date +%F) ]]; then echo today; elif [[ $d == $(date -d yesterday +%F) ]]; then echo yesterday
  elif [[ ${d%%-*} == $(date +%Y) ]]; then date -d "@$1" '+%-d %b'; else date -d "@$1" '+%b %Y'; fi
}
st_room(){ awk -v b="$1" 'BEGIN { if (b >= 2^30) printf "%.1f GB", b / 2^30; else if (b >= 2^20) printf "%d MB", b / 2^20; else printf "<1 MB" }'; }
state_lines(){
  local n name bytes when cur chg note i last="" wn=0 ww=0 wr=0 wm=0 b=$'\e[1m' d=$'\e[2m' z=$'\e[0m'
  local -a N=() S=() C=() W=() R=() M=() T=()
  while IFS=$'\t' read -r n name bytes when cur chg note; do
    i=${#N[@]}; N[i]=$n S[i]=$name C[i]="" W[i]="" R[i]="" M[i]="" T[i]=$note
    [[ $cur == loaded ]] && W[i]=current
    [[ $chg == changed ]] && W[i]="unsaved changes" C[i]=$'\e[33m'
    [[ $cur == loaded && $(state_of "$n") == running ]] && W[i]=running C[i]=$'\e[32m'
    [[ $when == - ]] || M[i]="saved $(st_day "$when")"
    [[ $bytes == - ]] || R[i]=$(st_room "$bytes")
    [[ $name == clean ]] && T[i]="what a reset returns to"
    (( ${#name} > wn )) && wn=${#name}; (( ${#W[i]} > ww )) && ww=${#W[i]}
    (( ${#M[i]} > wm )) && wm=${#M[i]}; (( ${#R[i]} > wr )) && wr=${#R[i]}
  done < <(state_rows)
  (( ww )) && ww=$(( ww + 3 )); (( wm )) && wm=$(( wm + 3 )); (( wr )) && wr=$(( wr + 3 ))
  for i in "${!N[@]}"; do
    if [[ ${N[i]} != "$last" ]]; then
      [[ -z $last ]] || printf -- '-\t-\t\n'
      case ${N[i]} in win) printf -- "-\t-\t${b}Windows$z\n" ;; mac) printf -- "-\t-\t${b}Mac$z\n" ;; esac; last=${N[i]}
    fi
    printf "%s\t%s\t%-$(( wn + 3 ))s${C[i]}%-${ww}s$z$d%-${wm}s%-${wr}s%s$z\n" "${N[i]}" "${S[i]}" "${S[i]}" "${W[i]}" "${M[i]}" "${R[i]}" "${T[i]}"
  done
}
state_json(){
  state_rows | jq -Rn '[inputs | split("\t") | {vm: .[0], state: .[1], size_bytes: (.[2] | tonumber? // null),
    saved: (.[3] | tonumber? // null | if . then todate else null end), loaded: (.[4] == "loaded"),
    changed: (.[5] == "changed"), note: .[6]}]'
}
# The list to work in (fzf): the VMs as titles, a line a state under each and the keys below, in
# the terminal's own colours and as tall as what it shows. The bar steps over the lines that
# are not states ($skip: their numbers). A key hands over to its work (state_do), which starts
# the list again with the bar on $1 $2.
state_menu(){
  local self items pos skip n step keys k=$'\e[0m' d=$'\e[2m'
  self=$(readlink -f "${BASH_SOURCE[0]}")
  items=$(state_lines); n=$(wc -l <<< "$items")
  skip=$(awk -F'\t' '$1 == "-" { printf " %d", NR } END { print " " }' <<< "$items")
  pos=$(awk -F'\t' -v n="${1:-}" -v s="${2:-}" '$1 == n && $2 == s { print NR }' <<< "$items")
  step="while case '$skip' in *\" \$p \"*) true ;; *) false ;; esac; do p=\$((p + i)); done"
  keys="${k}enter$d start   ${k}s$d save   ${k}n$d save as new   ${k}e$d note   ${k}d$d delete   ${k}q$d quit$k"
  fzf --ansi --no-sort --layout=reverse --margin=1,2,0,2 --height=$(( n + 3 )) <<< "$items" \
    --no-input --info=hidden --no-separator --no-scrollbar --no-mouse --delimiter=$'\t' --with-nth=3 \
    --ellipsis='…' --pointer='❯' --gutter=' ' --color='16,fg+:-1:bold,bg+:-1,gutter:-1,pointer:4,footer:-1' \
    --footer=$'\n'"$keys" --footer-border=none --bind="load:pos(${pos:-2})" \
    --bind="down,j,ctrl-n,tab:transform:i=1; p=\$((FZF_POS + 1)); $step; [ \$p -le $n ] || p=2; echo \"pos(\$p)\"" \
    --bind="up,k,ctrl-p,shift-tab:transform:i=-1; p=\$((FZF_POS - 1)); $step; [ \$p -ge 1 ] || p=$n; echo \"pos(\$p)\"" \
    --bind="home:pos(2),end:last,page-up:ignore,page-down:ignore,q:abort" \
    --bind="enter:become($self start {1} {2} --window)" \
    --bind="s:become($self states --do save {1} {2})" \
    --bind="n:become($self states --do new {1} {2})" \
    --bind="e:become($self states --do note {1} {2})" \
    --bind="d:become($self states --do clear {1} {2})" || true
}
# The list's keys: the work, then the list again with the bar where it was (on the new state
# after "save as new"). The list shows what a key did; only a refusal waits for a key press, so
# that it can be read first. Questions here take one key, without Enter.
ask1(){ local a; read -r -n1 -p "$1 [y/N] " a < /dev/tty; echo > /dev/tty; [[ $a == [yY] ]]; }
state_do(){
  local act=$1 n=$2 name=${3:-} new="" note rc=0
  printf '\e7\n' > /dev/tty          # the place the list was at: its questions go there
  [[ $act != new ]] || read -r -e -p "Name for $n as it is now: " new < /dev/tty || true
  (
    case $act in
      save) [[ $name != clean ]] || die "the clean state is not saved over (vm commit $n changes it)"
        ask1 "Save $n as it is now over '$name'?" || exit 3
        stop_for_save "$n" && cmd_save "$n" "$name" --replace ;;
      new) [[ -n $new ]] || exit 3
        [[ $new =~ ^[a-z0-9][a-z0-9._-]{0,15}$ && $new != clean ]] || die "a name is up to 16 lower-case letters, digits and . _ -"
        ! st_has "$n" "$new" || die "$n has a state '$new' already"
        read -r -e -p "Note (may be empty): " note < /dev/tty
        stop_for_save "$n" && cmd_save "$n" "$new" $note ;;
      note) [[ $name != clean ]] || die "the clean state has no note"
        read -r -e -i "$(head -n1 "$STATES_DIR/$n/$name.note" 2>/dev/null || true)" -p "Note on '$name': " note < /dev/tty
        cmd_note "$n" "$name" "$note" ;;
      clear) [[ $name != clean ]] || die "the clean state cannot be deleted"
        ask1 "Delete $n's state '$name'? This cannot be undone." || exit 3
        cmd_clear "$n" "$name" -y ;;
    esac
  ) > /dev/null || rc=$?
  (( rc == 0 || rc == 3 )) || read -r -n1 -s -p "(any key)" < /dev/tty || true
  (( rc == 0 )) && [[ $act == new ]] && name=$new
  printf '\e8\e[J' > /dev/tty        # and are gone when the list is back
  state_menu "$n" "$name"
}
stop_for_save(){
  [[ $(state_of "$1") == running ]] || return 0
  ask1 "$1 is running, and a state is the disk of a VM that is shut down. Shut it down now?" || exit 3
  echo "shutting $1 down" > /dev/tty; cmd_stop "$1"
}

cmd_states(){
  case ${1:-} in
    --json) state_json ;;
    --plain) state_table ;;
    --do) shift; state_do "$@" ;;
    '') if tty_both && command -v fzf > /dev/null; then state_menu; else state_table; fi ;;
    *) die "usage: vm states [--plain|--json]" ;;
  esac
}
# vm save <name> <state> [--replace] [note...]
cmd_save(){
  local n=$1 name=${2:-} replace=0 a note=(); need "$n"; shift 2 || die "usage: vm save <name> <state> [--replace] [note...]"
  for a in "$@"; do [[ $a == --replace ]] && replace=1 || note+=("$a"); done
  [[ $(state_of "$n") != running ]] || die "$n is running: vm stop $n first (a state is the disk of a VM that is shut down)"
  if (( ! replace )) && st_has "$n" "$name"; then
    if tty_both; then ask "$n has a state '$name' already. Replace it?" || die "not saved"
    else die "$n has a state '$name' already: vm save $n $name --replace writes over it"; fi
  fi
  "${RUN[$n]}" state save "$name" > /dev/null || exit 1
  (( ${#note[@]} )) && echo "${note[*]}" > "$STATES_DIR/$n/$name.note"
  echo "$n: saved as '$name' (start it with: vm start $n $name)"
}
cmd_note(){
  local n=$1 name=$2; need "$n"; shift 2
  st_has "$n" "$name" || die "$n has no state '$name' (vm states)"
  mkdir -p "$STATES_DIR/$n"; echo "$*" > "$STATES_DIR/$n/$name.note"; echo "$n: note on '$name' set"
}
# vm clear <name> <state>... | --all   [-y]
cmd_clear(){
  local n=$1 a yes=0 all=0 names=(); need "$n"; shift
  for a in "$@"; do case $a in -y|--yes) yes=1 ;; --all) all=1 ;; *) names+=("$a") ;; esac; done
  (( all )) && mapfile -t names < <("${RUN[$n]}" state list | cut -f1)
  (( ${#names[@]} )) || { (( all )) && { echo "$n has no states"; return; }; die "usage: vm clear <name> <state>... | --all  [-y]"; }
  for a in "${names[@]}"; do st_has "$n" "$a" || die "$n has no state '$a' (vm states)"; done
  if (( ! yes )) && tty_both; then ask "Delete $n's state${names[1]:+s} ${names[*]}? This cannot be undone." || die "nothing deleted"; fi
  for a in "${names[@]}"; do "${RUN[$n]}" state rm "$a" > /dev/null || exit 1; echo "$n: '$a' deleted"; done
}

cmd_help(){ cat <<'EOF'
vm status                      which VM is running, where its SSH is, who started it
vm start <win|mac> [state] [--window]
                               boot (refuses if the other VM is running) and wait for SSH.
                               With a state (vm states): that state's disk, or the VM as it
                               stopped if it is on that state already.
                               --window: in a window on the desktop (full screen: its title
                               bar's button or Ctrl+Alt+F; shared clipboard; files dropped on
                               it land on the guest's desktop). Without: no window
ssh <win|mac> "<command>"      plain ssh (hosts from install.sh): a command on the VM's desktop
                               as dev. win: PowerShell 7 with admin rights; mac: a zsh login
                               shell, sudo without a password. A script on stdin
                               (ssh win <<'EOF' ... EOF); scp and sftp too. Leave out -t
vm run, vm execute             older forms of the same (a script, one command; --timeout SEC),
                               kept for scripts that use them
vm push <name> <dir> [dest]    mirror the git work tree at <dir>, uncommitted and untracked
                               files too (not ignored ones), to the guest's build cache:
                               C:\cache\src\<repo> on win, ~/cache/src/<repo> on mac, or to
                               <dest>. Later pushes send only the changes and keep the
                               guest's build output
vm cache                       how large each VM's build cache is. C:\cache and ~/cache are a
                               disk of their own that reset and commit leave alone
vm cache clear <name>          empty that VM's build cache (VM must be stopped)
vm tunnel <name> <port> [lp]   forward VM's 127.0.0.1:<port> to localhost:<lp>
vm untunnel <localport>        close a tunnel opened by vm tunnel
vm forward <name> <port>...    the other way: this machine's 127.0.0.1:<port> on the VM's own
                               localhost:<port> (GUEST:HOST for another number in the VM)
vm unforward <name>            close that VM's forwards
vm gui <name> shot FILE.png    the VM's screen as a picture, whatever is on it
vm gui <name> click X Y [right|double] | move X Y | drag X1 Y1 X2 Y2
vm gui <name> type 'text' | key ctrl+s [ret ...] | size
                               the VM's own keyboard and pointer, at pixels of that picture.
                               The guest takes them for a person's (Windows does not mark
                               them as injected). Key names: win (= cmd), alt, ctrl, shift
                               and QEMU's (ret, esc, tab, f4, up, delete, a, 1)
vm view <name>                 start it in its window; if it already runs without one, win
                               opens a plain viewer and mac has to be stopped first
vm ip <name>, vm port <name>   where the VM's SSH is: 127.0.0.1 and a port (win 2222, mac 2227)
Shared folder: /vmlab/share on this machine is C:\share on win and ~/share on mac.
vm stop <name>                 graceful shutdown (forced after 2 min)
vm reset <name> [--discard]    discard all changes since the clean state (VM must be stopped).
                               A VM that ran on a named state and was not saved since is
                               only reset with --discard
vm commit <name>               make the current state the new clean state (VM must be stopped).
                               win: its named states stand on the clean state.
                               --keep-states moves them to the new one, each as it was;
                               --drop-states deletes them
vm save <name> <state> [note]  keep the stopped VM's disk as it is under a name, beside the
                               clean state. --replace writes over a state of that name
vm note <name> <state> text    the line of text the list shows beside a state
vm states                      the states of both VMs. In a terminal: a list to work in (start,
                               save, note, delete). --plain: a table. --json: for programs
vm clear <name> <state>...     delete states; --all: every state of that VM. In a terminal it
                               asks first (-y: no question)
EOF
}

sub=${1:-help}; shift || true
case $sub in
  status|help) "cmd_$sub" ;;
  start) [[ $# -ge 1 ]] || die "usage: vm start <name> [state] [--window]"; cmd_start "$@" ;;
  stop|ip|port|view) [[ $# -eq 1 ]] || die "usage: vm $sub <name>"; "cmd_$sub" "$1" ;;
  reset|commit) [[ $# -ge 1 ]] || die "usage: vm $sub <name>"; "cmd_$sub" "$@" ;;
  states) cmd_states "$@" ;;
  save) [[ $# -ge 2 ]] || die "usage: vm save <name> <state> [--replace] [note...]"; cmd_save "$@" ;;
  note) [[ $# -ge 3 ]] || die "usage: vm note <name> <state> <text>"; cmd_note "$@" ;;
  clear) [[ $# -ge 2 ]] || die "usage: vm clear <name> <state>... | --all  [-y]"; cmd_clear "$@" ;;
  ssh) [[ $# -ge 1 ]] || die "usage: vm ssh <name> [cmd]"; cmd_ssh "$@" ;;
  execute) [[ $# -ge 1 ]] || die "usage: vm execute <name> [--timeout SEC] \"<command>\""; cmd_execute "$@" ;;
  run) [[ $# -ge 1 ]] || die "usage: vm run <name> [--timeout SEC] [FILE] (the script on stdin or in FILE)"; cmd_run "$@" ;;
  untunnel) [[ $# -ge 1 ]] || die "usage: vm untunnel <localport>"; cmd_untunnel "$1" ;;
  cache) cmd_cache "$@" ;;
  push) [[ $# -ge 2 && $# -le 3 ]] || die "usage: vm push <name> <dir> [dest]"; cmd_push "$@" ;;
  tunnel) [[ $# -ge 2 ]] || die "usage: vm tunnel <name> <port> [localport]"; cmd_tunnel "$@" ;;
  forward) [[ $# -ge 2 ]] || die "usage: vm forward <name> <port|guestport:hostport>..."; cmd_forward "$@" ;;
  unforward) [[ $# -ge 1 ]] || die "usage: vm unforward <name>"; cmd_unforward "$1" ;;
  gui) [[ $# -ge 2 ]] || die "usage: vm gui <name> shot FILE.png | click X Y | type 'text' | key ctrl+s (vm help)"; cmd_gui "$@" ;;
  *) die "unknown command '$sub' (vm help)" ;;
esac
